---
import Hero from "../components/public/Hero";
import Layout from "../layouts/Layout.astro";
import Services from "../components/public/Services";
import Products from "../components/public/Products";
import Gallery from "../components/public/Gallery";
import Team from "../components/public/Team";
import Testimonials from "../components/public/Testimonials"
import Footer from "../components/public/Footer"

// CMS Data
import { createSupabaseClient } from "../lib/supabase";
import { heroData as staticHeroData } from "../data/public/hero.data";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

const { data: dbHeroData } = await supabase
  .from("hero_content")
  .select("*")
  .single();

const heroData = dbHeroData || staticHeroData;
---

<Layout title="Barber Ray | Estilo y Tradición">
  <Hero initialData={heroData} client:load />
  <Services />
  <Products client:load />
  <Gallery client:load />
  <Team client:load />
  <Testimonials client:load />
  <Footer/>
</Layout>
