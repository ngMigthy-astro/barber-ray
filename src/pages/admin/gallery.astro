---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import { uploadImage } from "../../lib/storage";
import {
  Trash2,
  Plus,
  Save,
  Upload,
  Image as ImageIcon,
  X,
} from "lucide-react";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

let successMessage = "";
let errorMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    const action = formData.get("action");

    if (action === "upsert_gallery") {
      const id = formData.get("id")?.toString();
      const imageFile = formData.get("image") as File;

      let image_url = formData.get("current_image")?.toString() || "";

      if (imageFile && imageFile.size > 0) {
        const uploadedUrl = await uploadImage(supabase, imageFile, "gallery");
        if (uploadedUrl) image_url = uploadedUrl;
      }

      if (!id && !image_url) {
        throw new Error(
          "Debes subir una imagen para crear un nuevo registro en la galería.",
        );
      }

      const galleryData = {
        alt: formData.get("alt")?.toString(),
        category: formData.get("category")?.toString(),
        image_url,
        sort_order: parseInt(formData.get("sort_order")?.toString() || "0"),
      };

      const { error } = id
        ? await supabase.from("gallery_images").update(galleryData).eq("id", id)
        : await supabase.from("gallery_images").insert([galleryData]);

      if (error) throw error;
      return Astro.redirect("/admin/gallery?success=true");
    } else if (action === "delete_gallery") {
      const id = formData.get("id")?.toString();
      const { error } = await supabase
        .from("gallery_images")
        .delete()
        .eq("id", id);
      if (error) throw error;
      return Astro.redirect("/admin/gallery?success=true");
    } else if (action === "add_gallery_category") {
      const name = formData.get("name")?.toString().trim();
      if (!name) throw new Error("El nombre de la categoría es requerido.");
      
      const { data: currentCats } = await supabase
        .from("gallery_categories")
        .select("id");
      
      const { error } = await supabase
        .from("gallery_categories")
        .insert([{ name, sort_order: (currentCats?.length || 0) + 1 }]);
      if (error) throw error;
      return Astro.redirect("/admin/gallery?success=true");
    } else if (action === "delete_gallery_category") {
      const id = formData.get("id")?.toString();
      const { error } = await supabase
        .from("gallery_categories")
        .delete()
        .eq("id", id);
      if (error) throw error;
      return Astro.redirect("/admin/gallery?success=true");
    }
  } catch (e) {
    errorMessage = (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";

// Consultar galería
const { data: dbGallery } = await supabase
  .from("gallery_images")
  .select("*")
  .order("sort_order", { ascending: true });

const gallery = dbGallery || [];

// Consultar categorías de galería
const { data: dbCategories } = await supabase
  .from("gallery_categories")
  .select("*")
  .order("sort_order", { ascending: true });

const categories = dbCategories || [];
---

<AdminLayout title="Gestión de Galería">
  <div class="w-full">
    {
      isSuccess && (
        <div
          id="success-notification"
          class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <Save className="w-5 h-5" />
            <span class="font-medium">
              La galería de imágenes ha sido actualizada correctamente.
            </span>
          </div>
          <button
            onclick="document.getElementById('success-notification').style.display='none'"
            class="text-emerald-500/70 hover:text-emerald-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          id="error-notification"
          class="mb-6 p-4 bg-red-500/10 border border-red-500/20 text-red-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <span class="font-medium">Error: {errorMessage}</span>
          </div>
          <button
            onclick="document.getElementById('error-notification').style.display='none'"
            class="text-red-500/70 hover:text-red-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Formulario Nueva Imagen -->
      <div class="lg:col-span-1 space-y-6">
        <div
          class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-xs sticky top-8"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-6 bg-indigo-600 dark:bg-indigo-500 rounded-full"></div>
            <h3 class="text-xs font-black text-zinc-900 dark:text-zinc-100 uppercase tracking-widest font-display">
              Subir Foto
            </h3>
          </div>

          <form method="POST" enctype="multipart/form-data" class="space-y-4">
            <input type="hidden" name="action" value="upsert_gallery" />

            <div class="space-y-2">
              <label
                class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
                >Archivo de Imagen *</label
              >
              <div class="relative group cursor-pointer">
                <input
                  type="file"
                  id="new-gallery-image"
                  name="image"
                  accept="image/*"
                  required
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                />
                <div
                  id="new-gallery-preview-container"
                  class="w-full h-32 bg-zinc-50 dark:bg-zinc-950 border border-dashed border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 group-hover:border-indigo-600 dark:group-hover:border-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
                >
                  <div
                    id="new-gallery-upload-ui"
                    class="flex flex-col items-center justify-center pointer-events-none"
                  >
                    <Upload className="w-6 h-6 mb-2" />
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-center"
                      >Seleccionar</span
                    >
                  </div>
                  <img
                    id="new-gallery-image-preview"
                    class="hidden w-full h-full object-cover"
                  />
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <label
                class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
                >Descripción / Alt</label
              >
              <input
                type="text"
                name="alt"
                required
                placeholder="Ej: Fade Clásico con textura"
                class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-900 dark:text-white text-sm outline-none focus:border-indigo-600 dark:focus:border-indigo-500 shadow-2xs"
              />
            </div>

            <div class="space-y-2">
              <label
                class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
                >Categoría</label
              >
              <select
                name="category"
                required
                class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-900 dark:text-white text-sm outline-none focus:border-indigo-600 dark:focus:border-indigo-500 cursor-pointer shadow-2xs"
              >
                <option value="" disabled selected>Seleccionar...</option>
                {
                  categories.map((cat) => (
                    <option value={cat.name} class="bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white">{cat.name}</option>
                  ))
                }
              </select>
            </div>

            <button
              type="submit"
              class="w-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 text-xs uppercase tracking-widest transition-all mt-4 cursor-pointer shadow-xs"
            >
              <Plus className="w-4 h-4" />
              Subir a Galería
            </button>
          </form>
        </div>

        <!-- Gestión de Categorías de Galería -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-xs">
          <details class="group select-none">
            <summary class="flex items-center justify-between font-black text-zinc-900 dark:text-white text-xs uppercase tracking-widest cursor-pointer list-none font-display">
              <div class="flex items-center gap-3">
                <div class="w-1.5 h-6 bg-indigo-600 dark:bg-indigo-500 rounded-full"></div>
                <span>Gestionar Categorías</span>
              </div>
              <span class="transition-transform duration-300 group-open:rotate-180 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            
            <div class="mt-6 space-y-6">
              <!-- Formulario Agregar Categoría -->
              <form method="POST" class="space-y-3">
                <input type="hidden" name="action" value="add_gallery_category" />
                <div class="space-y-2">
                  <label class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1">Nueva Categoría</label>
                  <div class="flex gap-2">
                    <input
                      type="text"
                      name="name"
                      placeholder="Ej: Color"
                      required
                      class="flex-1 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3 py-2.5 text-zinc-900 dark:text-white text-sm outline-none focus:border-indigo-600 dark:focus:border-indigo-500 shadow-2xs"
                    />
                    <button
                      type="submit"
                      class="bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white rounded-xl px-4 flex items-center justify-center cursor-pointer transition-all shadow-2xs"
                    >
                      <Plus className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              </form>

              <!-- Lista de Categorías Existentes -->
              <div class="space-y-2">
                <label class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1">Categorías Actuales</label>
                <div class="max-h-48 overflow-y-auto space-y-2 pr-1 custom-scrollbar">
                  {
                    categories.map((cat) => (
                      <div class="flex items-center justify-between bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2">
                        <span class="text-sm font-semibold text-zinc-850 dark:text-zinc-300">{cat.name}</span>
                        <form method="POST" class="inline">
                          <input type="hidden" name="action" value="delete_gallery_category" />
                          <input type="hidden" name="id" value={cat.id} />
                          <button
                            type="submit"
                            class="text-zinc-400 dark:text-zinc-500 hover:text-red-600 dark:hover:text-red-500 transition-colors cursor-pointer"
                            onclick="return confirm('¿Seguro que deseas eliminar esta categoría?')"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </form>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>

      <!-- Grid de Galería -->
      <div class="lg:col-span-3">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-black text-zinc-900 dark:text-white uppercase tracking-tight font-display">Fotos en el Portafolio</h3>
          <span
            class="px-3 py-1 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-full text-[10px] font-black text-zinc-500 dark:text-zinc-400 uppercase tracking-widest"
            >{gallery.length} fotos</span
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            gallery.map((image, index) => (
              <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden hover:border-indigo-600 dark:hover:border-indigo-500 hover:shadow-xs transition-all duration-300 group flex flex-col">
                <div class="relative aspect-[4/3] w-full bg-zinc-50 dark:bg-zinc-950 flex items-center justify-center overflow-hidden border-b border-zinc-100 dark:border-zinc-850 shadow-inner">
                  {image.image_url ? (
                    <img
                      src={image.image_url}
                      alt={image.alt}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <ImageIcon className="w-10 h-10 text-zinc-350 dark:text-zinc-700" />
                  )}

                  <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center cursor-pointer z-10">
                    <form
                      method="POST"
                      enctype="multipart/form-data"
                      class="text-center"
                    >
                      <input
                        type="hidden"
                        name="action"
                        value="upsert_gallery"
                      />
                      <input type="hidden" name="id" value={image.id} />
                      <input
                        type="hidden"
                        name="current_image"
                        value={image.image_url}
                      />
                      <input type="hidden" name="alt" value={image.alt} />
                      <input
                        type="hidden"
                        name="category"
                        value={image.category}
                      />
                      <input type="hidden" name="sort_order" value={index} />

                      <Upload className="w-8 h-8 text-white mx-auto mb-2" />
                      <span class="text-xs text-white font-bold uppercase tracking-widest">
                        Cambiar Imagen
                      </span>

                      <input
                        type="file"
                        name="image"
                        accept="image/*"
                        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                        onchange="this.form.submit()"
                      />
                    </form>
                  </div>
                </div>

                <div class="p-5 flex-1 flex flex-col">
                  <form method="POST" class="flex-1 space-y-3">
                    <input type="hidden" name="action" value="upsert_gallery" />
                    <input type="hidden" name="id" value={image.id} />
                    <input
                      type="hidden"
                      name="current_image"
                      value={image.image_url}
                    />
                    <input type="hidden" name="sort_order" value={index} />

                    <input
                      type="text"
                      name="alt"
                      value={image.alt}
                      required
                      class="w-full bg-transparent text-sm font-black text-zinc-900 dark:text-white outline-none focus:text-indigo-600 dark:focus:text-indigo-500 transition-colors border-b border-transparent focus:border-zinc-200 dark:focus:border-zinc-800 pb-1 font-display"
                    />

                    <div class="flex items-center gap-2">
                      <select
                        name="category"
                        required
                        class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-lg px-2.5 py-1 text-zinc-500 dark:text-zinc-400 text-3xs font-bold uppercase tracking-widest outline-none focus:border-indigo-600 dark:focus:border-indigo-500 cursor-pointer shadow-2xs"
                      >
                        {
                          !categories.some((cat) => cat.name === image.category) && (
                            <option value={image.category} selected class="bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white">
                              {image.category}
                            </option>
                          )
                        }
                        {
                          categories.map((cat) => (
                            <option
                              value={cat.name}
                              selected={image.category === cat.name}
                              class="bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white"
                            >
                              {cat.name}
                            </option>
                          ))
                        }
                      </select>
                    </div>

                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-4 mt-auto border-t border-zinc-100 dark:border-zinc-800/80">
                      <button
                        type="submit"
                        class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 sm:py-1.5 sm:px-3 text-xs sm:text-[10px] font-black bg-indigo-600 sm:bg-transparent dark:bg-indigo-500 dark:sm:bg-transparent text-white sm:text-indigo-600 dark:sm:text-indigo-400 hover:bg-indigo-700 dark:hover:bg-indigo-600 sm:hover:bg-indigo-50 dark:sm:hover:bg-indigo-500/10 border border-transparent sm:border sm:border-indigo-200 dark:sm:border-indigo-500/20 rounded-xl sm:rounded-lg transition-colors uppercase tracking-widest cursor-pointer shadow-xs sm:shadow-none"
                        title="Guardar cambios"
                      >
                        <Save className="w-3.5 h-3.5" />
                        <span>Guardar</span>
                      </button>
                      <button
                        form={`delete-${image.id}`}
                        type="submit"
                        class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 sm:py-1.5 sm:px-3 text-xs sm:text-[10px] font-black bg-red-500/10 sm:bg-transparent text-red-650 dark:text-red-500 sm:text-zinc-405 dark:sm:text-zinc-500 hover:bg-red-650 dark:hover:bg-red-600 sm:hover:bg-red-500/10 hover:text-white sm:hover:text-red-600 dark:sm:hover:text-red-400 border border-transparent sm:border-none rounded-xl sm:rounded-lg transition-colors uppercase tracking-widest cursor-pointer"
                        title="Eliminar del portafolio"
                      >
                        <Trash2 className="w-3.5 h-3.5" />
                        <span>Eliminar</span>
                      </button>
                    </div>
                  </form>

                  <form id={`delete-${image.id}`} method="POST" class="hidden">
                    <input type="hidden" name="action" value="delete_gallery" />
                    <input type="hidden" name="id" value={image.id} />
                  </form>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fileInput = document.getElementById(
      "new-gallery-image",
    ) as HTMLInputElement;
    const previewImg = document.getElementById(
      "new-gallery-image-preview",
    ) as HTMLImageElement;
    const uploadUi = document.getElementById("new-gallery-upload-ui");

    if (fileInput && previewImg && uploadUi) {
      fileInput.addEventListener("change", (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            previewImg.src = e.target?.result as string;
            previewImg.classList.remove("hidden");
            uploadUi.classList.add("hidden");
          };
          reader.readAsDataURL(file);
        } else {
          previewImg.src = "";
          previewImg.classList.add("hidden");
          uploadUi.classList.remove("hidden");
        }
      });
    }
  });
</script>
