---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import { servicesData as staticServicesData } from "../../data/public/services.data";
import {
  Scissors,
  Brush,
  Sparkles,
  Wind,
  Trash2,
  Plus,
  Save,
  X,
} from "lucide-react";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

// 1. Obtener configuración de la sección
const { data: sectionConfig } = await supabase
  .from("section_configs")
  .select("*")
  .eq("id", "services")
  .single();

const config = sectionConfig || {
  title: staticServicesData.title,
  subtitle: staticServicesData.subtitle,
};

// 2. Obtener lista de servicios
const { data: dbServices } = await supabase
  .from("services")
  .select("*")
  .order("sort_order", { ascending: true });

const services = dbServices?.length
  ? dbServices
  : staticServicesData.services.map((s, i) => ({
      ...s,
      icon_name: s.icon.name || "Scissors", // Fallback
      sort_order: i,
    }));

// 3. Manejar Acciones (POST)
let successMessage = "";
let errorMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    const action = formData.get("action");

    if (action === "update_config") {
      const { error } = await supabase.from("section_configs").upsert({
        id: "services",
        title: formData.get("title")?.toString() || "",
        subtitle: formData.get("subtitle")?.toString() || "",
        updated_at: new Date().toISOString(),
      });
      if (error) throw error;
      successMessage = "¡Configuración de la sección actualizada!";
    } else if (action === "upsert_service") {
      const id = formData.get("id")?.toString();
      const serviceData = {
        name: formData.get("name")?.toString() || "",
        description: formData.get("description")?.toString() || "",
        price: formData.get("price")?.toString() || "",
        duration: formData.get("duration")?.toString() || "",
        icon_name: formData.get("icon_name")?.toString() || "Scissors",
        sort_order: parseInt(formData.get("sort_order")?.toString() || "0"),
      };

      const { error } = id
        ? await supabase.from("services").update(serviceData).eq("id", id)
        : await supabase.from("services").insert([serviceData]);

      if (error) throw error;
      successMessage = id
        ? "¡Servicio actualizado!"
        : "¡Nuevo servicio creado!";
    } else if (action === "delete_service") {
      const id = formData.get("id")?.toString();
      const { error } = await supabase.from("services").delete().eq("id", id);
      if (error) throw error;
      successMessage = "Servicio eliminado correctamente.";
    }

    return Astro.redirect("/admin/services?success=true");
  } catch (e) {
    errorMessage = (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";

const availableIcons = [
  { name: "Scissors", icon: Scissors },
  { name: "Brush", icon: Brush },
  { name: "Sparkles", icon: Sparkles },
  { name: "Wind", icon: Wind },
];
---

<AdminLayout title="Gestión de Servicios">
  <div class="max-w-5xl">
    {
      isSuccess && (
        <div
          id="success-notification"
          class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <Save className="w-5 h-5" />
            <span class="font-medium">
              Los cambios se han guardado y publicado correctamente.
            </span>
          </div>
          <button
            onclick="document.getElementById('success-notification').style.display='none'"
            class="text-emerald-500/70 hover:text-emerald-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          id="error-notification"
          class="mb-6 p-4 bg-red-500/10 border border-red-500/20 text-red-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <span class="font-medium">Error: {errorMessage}</span>
          </div>
          <button
            onclick="document.getElementById('error-notification').style.display='none'"
            class="text-red-500/70 hover:text-red-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Configuración de la Sección -->
      <div class="lg:col-span-1 space-y-6">
        <div
          class="bg-stone-900 border border-stone-800 rounded-3xl p-6 shadow-xl"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-6 bg-primary rounded-full"></div>
            <h3 class="text-sm font-black text-white uppercase tracking-widest">
              Textos de Sección
            </h3>
          </div>

          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value="update_config" />
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Título Principal</label
              >
              <input
                type="text"
                name="title"
                value={config.title}
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all text-sm"
              />
            </div>
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Subtítulo</label
              >
              <input
                type="text"
                name="subtitle"
                value={config.subtitle}
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all text-sm"
              />
            </div>
            <button
              type="submit"
              class="w-full btn-premium py-3 flex items-center justify-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              Guardar Sección
            </button>
          </form>
        </div>

        <!-- Agregar Nuevo Servicio -->
        <div
          class="bg-stone-900 border border-stone-800 rounded-3xl p-6 shadow-xl"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-6 bg-emerald-500 rounded-full"></div>
            <h3 class="text-sm font-black text-white uppercase tracking-widest">
              Nuevo Servicio
            </h3>
          </div>

          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value="upsert_service" />
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Nombre</label
                >
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                />
              </div>
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Icono</label
                >
                <select
                  name="icon_name"
                  class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                >
                  {
                    availableIcons.map((icon) => (
                      <option value={icon.name}>{icon.name}</option>
                    ))
                  }
                </select>
              </div>
            </div>
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Descripción Corta</label
              >
              <textarea
                name="description"
                rows="2"
                required
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500 resize-none"
              ></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Precio</label
                >
                <input
                  type="text"
                  name="price"
                  placeholder="$00"
                  required
                  class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                />
              </div>
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Duración</label
                >
                <input
                  type="text"
                  name="duration"
                  placeholder="00 min"
                  required
                  class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                />
              </div>
            </div>
            <button
              type="submit"
              class="w-full bg-emerald-500 hover:bg-emerald-600 text-stone-950 font-black py-3 rounded-xl flex items-center justify-center gap-2 text-xs uppercase tracking-widest transition-all cursor-pointer"
            >
              <Plus className="w-4 h-4" />
              Crear Servicio
            </button>
          </form>
        </div>
      </div>

      <!-- Lista de Servicios Actuales -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xl font-bold text-white">Servicios Activos</h3>
          <span
            class="px-3 py-1 bg-stone-900 border border-stone-800 rounded-full text-2xs font-black text-stone-500 uppercase"
            >{services.length} items</span
          >
        </div>

        <div class="grid grid-cols-1 gap-4">
          {
            services.map((service, index) => (
              <div class="bg-stone-900 border border-stone-800 rounded-4xl p-6 hover:border-primary/50 transition-all group">
                <form method="POST" class="flex flex-col md:flex-row gap-6">
                  <input type="hidden" name="action" value="upsert_service" />
                  <input type="hidden" name="id" value={service.id} />
                  <input type="hidden" name="sort_order" value={index} />

                  {/* Icono y Meta */}
                  <div class="flex flex-col items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-stone-950 flex items-center justify-center text-primary border border-stone-800">
                      {
                        (() => {
                          const iconEntry = availableIcons.find(
                            (i) => i.name === service.icon_name,
                          );
                          const IconComponent = iconEntry?.icon || Scissors;
                          return <IconComponent className="w-8 h-8" />;
                        })()
                      }
                    </div>
                    <select
                      name="icon_name"
                      class="bg-stone-950 border border-stone-800 rounded-lg px-2 py-1 text-2xs text-stone-400 outline-none w-20"
                    >
                      {availableIcons.map((icon) => (
                        <option
                          value={icon.name}
                          selected={service.icon_name === icon.name}
                        >
                          {icon.name}
                        </option>
                      ))}
                    </select>
                  </div>

                  {/* Formulario Principal */}
                  <div class="flex-1 space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <input
                        type="text"
                        name="name"
                        value={service.name}
                        class="bg-transparent text-xl font-bold text-white outline-none focus:text-primary transition-colors"
                      />
                      <div class="flex gap-2">
                        <input
                          type="text"
                          name="price"
                          value={service.price}
                          class="w-20 bg-stone-950 border border-stone-800 rounded-lg px-3 py-1 text-primary font-black text-center"
                        />
                        <input
                          type="text"
                          name="duration"
                          value={service.duration}
                          class="flex-1 bg-stone-950 border border-stone-800 rounded-lg px-3 py-1 text-2xs text-stone-500 font-bold uppercase text-center"
                        />
                      </div>
                    </div>
                    <textarea
                      name="description"
                      rows="2"
                      class="w-full bg-transparent text-stone-400 text-sm outline-none focus:text-stone-200 transition-colors resize-none"
                    >
                      {service.description}
                    </textarea>

                    <div class="flex items-center justify-end gap-3 pt-2 border-t border-stone-800/50">
                      <button
                        type="submit"
                        class="flex items-center gap-2 text-xs font-black text-stone-500 hover:text-emerald-500 transition-colors uppercase tracking-widest cursor-pointer"
                      >
                        <Save className="w-3 h-3" />
                        Guardar
                      </button>
                      <button
                        form={`delete-${service.id}`}
                        type="submit"
                        class="flex items-center gap-2 text-xs font-black text-stone-500 hover:text-red-500 transition-colors uppercase tracking-widest cursor-pointer"
                      >
                        <Trash2 className="w-3 h-3" />
                        Eliminar
                      </button>
                    </div>
                  </div>
                </form>

                {/* Formulario Oculto para Eliminar */}
                <form id={`delete-${service.id}`} method="POST" class="hidden">
                  <input type="hidden" name="action" value="delete_service" />
                  <input type="hidden" name="id" value={service.id} />
                </form>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
