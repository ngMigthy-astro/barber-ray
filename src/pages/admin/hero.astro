---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import { uploadImage } from "../../lib/storage";
import type {
  HeroData,
  HeroCTA,
  HeroStat,
} from "../../interfaces/public/hero.interface";
import { X, Upload, ImageIcon } from "lucide-react";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

const { data: dbHeroData, error: fetchError } = await supabase
  .from("hero_content")
  .select("*")
  .single();

const hero: HeroData = (dbHeroData as unknown as HeroData) || {
  title: "",
  subtitle: "",
  description: "",
  image_url: "",
  ctas: [
    { text: "", href: "" },
    { text: "", href: "" },
  ],
  stats: [
    { value: "", label: "" },
    { value: "", label: "" },
    { value: "", label: "" },
  ],
};

let successMessage = "";
let errorMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();

    const stats: HeroStat[] = [
      {
        value: formData.get("stat1_value")?.toString() || "",
        label: formData.get("stat1_label")?.toString() || "",
      },
      {
        value: formData.get("stat2_value")?.toString() || "",
        label: formData.get("stat2_label")?.toString() || "",
      },
      {
        value: formData.get("stat3_value")?.toString() || "",
        label: formData.get("stat3_label")?.toString() || "",
      },
    ];

    const imageFile = formData.get("image") as File;
    let image_url = formData.get("current_image")?.toString() || "";

    if (imageFile && imageFile.size > 0) {
      const uploadedUrl = await uploadImage(supabase, imageFile, "hero");
      if (uploadedUrl) image_url = uploadedUrl;
    }

    const updatedHero: Partial<HeroData & { image_url: string }> = {
      title: formData.get("title")?.toString() || "",
      subtitle: formData.get("subtitle")?.toString() || "",
      description: formData.get("description")?.toString() || "",
      image_url,
      stats,
    };

    const { error: updateError } = await supabase.from("hero_content").upsert({
      id: dbHeroData?.id,
      ...updatedHero,
      updated_at: new Date().toISOString(),
    });

    if (updateError) throw updateError;
    successMessage = "Hero actualizado correctamente.";

    return Astro.redirect("/admin/hero?success=true");
  } catch (e) {
    errorMessage = "Error al actualizar: " + (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";
---

<AdminLayout title="Editar Hero Section">
  <div class="w-full space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <div class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <h2 class="text-2xl font-black text-zinc-950 dark:text-white uppercase tracking-tight font-display">Configuración del Hero</h2>
      <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1 font-medium">
        Personaliza el mensaje principal que ven tus clientes al entrar al sitio.
      </p>
    </div>

    {
      isSuccess && (
        <div
          id="success-notification"
          class="p-4 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-250 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4 shadow-2xs"
        >
          <div class="flex items-center gap-3">
            <svg
              class="w-5 h-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              />
            </svg>
            <span class="font-medium text-sm">
              Los cambios se han guardado correctamente.
            </span>
          </div>
          <button
            onclick="document.getElementById('success-notification').style.display='none'"
            class="text-emerald-500/70 hover:text-emerald-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          id="error-notification"
          class="p-4 bg-red-50 dark:bg-red-500/10 border border-red-250 dark:border-red-500/20 text-red-700 dark:text-red-400 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4 shadow-2xs"
        >
          <div class="flex items-center gap-3">
            <svg
              class="w-5 h-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span class="font-medium text-sm">{errorMessage}</span>
          </div>
          <button
            onclick="document.getElementById('error-notification').style.display='none'"
            class="text-red-500/70 hover:text-red-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    <form method="POST" enctype="multipart/form-data" class="space-y-8">
      <input type="hidden" name="current_image" value={hero.image_url} />

      <!-- Imagen de Fondo -->
      <div
        class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 space-y-6 shadow-xs"
      >
        <div class="flex items-center gap-3">
          <div class="w-1.5 h-6 bg-indigo-600 dark:bg-indigo-500 rounded-full"></div>
          <h3 class="text-xs font-black text-zinc-900 dark:text-zinc-100 uppercase tracking-widest font-display">
            Imagen de Fondo (Hero Background)
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          <div class="md:col-span-1">
            <div
              class="relative group aspect-video md:aspect-square bg-zinc-50 dark:bg-zinc-900 border-2 border-dashed border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden flex items-center justify-center hover:border-indigo-600 dark:hover:border-indigo-500 transition-all cursor-pointer shadow-inner"
            >
              <img
                id="hero-preview"
                src={hero.image_url || "/images/hero-bg.jpg"}
                class="absolute inset-0 w-full h-full object-cover opacity-100 group-hover:opacity-30 transition-opacity duration-300"
              />
              <div
                class="relative z-10 flex flex-col items-center gap-2 text-zinc-400 dark:text-zinc-600 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none"
              >
                <Upload className="w-8 h-8" />
                <span class="text-[10px] font-black uppercase tracking-widest"
                  >Cambiar Imagen</span
                >
              </div>
              <input
                type="file"
                name="image"
                accept="image/*"
                id="hero-upload"
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
              />
            </div>
          </div>
          <div class="md:col-span-2 space-y-4">
            <div
              class="p-4 bg-zinc-50 dark:bg-zinc-900/50 rounded-xl border border-zinc-200 dark:border-zinc-800/60 shadow-2xs"
            >
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                <span class="text-indigo-600 dark:text-indigo-400 font-black uppercase tracking-wider text-2xs mr-1">Tip</span> Para el Hero, usa imágenes
                horizontales (landscape) de alta resolución (mínimo 1920x1080). Las
                imágenes con tonos oscuros funcionan mejor con el diseño de branding "Indigo & Zinc".
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Textos Principales -->
      <div
        class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 space-y-6 shadow-xs"
      >
        <div class="flex items-center gap-3">
          <div class="w-1.5 h-6 bg-indigo-600 dark:bg-indigo-500 rounded-full"></div>
          <h3 class="text-xs font-black text-zinc-900 dark:text-zinc-100 uppercase tracking-widest font-display">
            Textos Principales
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label
              class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
              >Título</label
            >
            <input
              type="text"
              name="title"
              value={hero.title}
              class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white focus:border-indigo-600 dark:focus:border-indigo-500 outline-none transition-all text-sm shadow-2xs"
              required
            />
          </div>
          <div class="space-y-2">
            <label
              class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
              >Subtítulo</label
            >
            <input
              type="text"
              name="subtitle"
              value={hero.subtitle}
              class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white focus:border-indigo-600 dark:focus:border-indigo-500 outline-none transition-all text-sm shadow-2xs"
              required
            />
          </div>
        </div>

        <div class="space-y-2">
          <label
            class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-1"
            >Descripción</label
          >
          <textarea
            name="description"
            rows="3"
            class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white focus:border-indigo-600 dark:focus:border-indigo-500 outline-none transition-all text-sm resize-none shadow-2xs"
            required>{hero.description}</textarea
          >
        </div>
      </div>



      <!-- Stats -->
      <div
        class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 space-y-6 shadow-xs"
      >
        <div class="flex items-center gap-3">
          <div class="w-1.5 h-6 bg-indigo-600 dark:bg-indigo-500 rounded-full"></div>
          <h3 class="text-xs font-black text-zinc-900 dark:text-zinc-100 uppercase tracking-widest font-display">
            Estadísticas (Stats)
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {
            hero.stats.map((stat, index) => (
              <div class="p-6 bg-zinc-50 dark:bg-zinc-900 rounded-xl border border-zinc-200 dark:border-zinc-800 space-y-3 shadow-2xs">
                <input
                  type="text"
                  name={`stat${index + 1}_value`}
                  placeholder="Valor (ej: 10+)"
                  value={stat.value}
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-lg px-3 py-2 text-lg font-black text-zinc-900 dark:text-white text-center focus:border-indigo-600 dark:focus:border-indigo-500 outline-none shadow-2xs font-display"
                />
                <input
                  type="text"
                  name={`stat${index + 1}_label`}
                  placeholder="Etiqueta"
                  value={stat.label}
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-600 dark:text-zinc-400 text-center focus:border-indigo-600 dark:focus:border-indigo-500 outline-none shadow-2xs"
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Submit -->
      <div class="flex justify-end w-full">
        <button
          type="submit"
          class="w-full sm:w-auto justify-center bg-indigo-600 hover:bg-indigo-750 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-bold py-3.5 px-8 rounded-xl transition-all shadow-xs hover:shadow-md active:scale-98 cursor-pointer text-sm uppercase tracking-wider font-display"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
<script>
  const heroUpload = document.getElementById("hero-upload") as HTMLInputElement;
  const heroPreview = document.getElementById(
    "hero-preview",
  ) as HTMLImageElement;

  if (heroUpload && heroPreview) {
    heroUpload.addEventListener("change", (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          heroPreview.src = event.target?.result as string;
          heroPreview.style.opacity = "0.8";
        };
        reader.readAsDataURL(file);
      }
    });
  }
</script>
