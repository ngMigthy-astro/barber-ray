---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import { heroData as staticHeroData } from "../../data/public/hero.data";
import type { HeroData } from "../../interfaces/public/hero.interface";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

// 1. Obtener datos actuales
const { data: dbHeroData, error: fetchError } = await supabase
  .from("hero_content")
  .select("*")
  .single();

const hero = (dbHeroData as unknown as HeroData) || staticHeroData;

// 2. Manejar la actualización (POST)
let successMessage = "";
let errorMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    
    // Procesar CTAs
    const ctas = [
      { text: formData.get("cta1_text"), href: formData.get("cta1_href") },
      { text: formData.get("cta2_text"), href: formData.get("cta2_href") },
    ];

    // Procesar Stats
    const stats = [
      { value: formData.get("stat1_value"), label: formData.get("stat1_label") },
      { value: formData.get("stat2_value"), label: formData.get("stat2_label") },
      { value: formData.get("stat3_value"), label: formData.get("stat3_label") },
    ];

    const updatedHero: Partial<HeroData> = {
      title: formData.get("title")?.toString(),
      subtitle: formData.get("subtitle")?.toString(),
      description: formData.get("description")?.toString(),
      ctas,
      stats,
    };

    const { error: updateError } = await supabase
      .from("hero_content")
      .upsert({ 
        id: dbHeroData?.id, // Si existe, actualiza. Si no, crea.
        ...updatedHero,
        updated_at: new Date().toISOString()
      });

    if (updateError) throw updateError;
    successMessage = "¡Hero actualizado correctamente! 🔥";
    
    // Recargar datos actualizados
    return Astro.redirect("/admin/hero?success=true");
  } catch (e) {
    errorMessage = "Error al actualizar: " + (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";
---

<AdminLayout title="Editar Hero Section">
  <div class="max-w-4xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Configuración del Hero</h2>
      <p class="text-stone-400 text-sm">Personaliza el mensaje principal que ven tus clientes al entrar al sitio.</p>
    </div>

    {isSuccess && (
      <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-2xl flex items-center gap-3 animate-in fade-in slide-in-from-top-4">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span class="font-medium">¡Cambios guardados con éxito, mi perrote!</span>
      </div>
    )}

    {errorMessage && (
      <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 text-red-500 rounded-2xl flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-medium">{errorMessage}</span>
      </div>
    )}

    <form method="POST" class="space-y-8">
      <!-- Textos Principales -->
      <div class="bg-stone-900 border border-stone-800 rounded-3xl p-8 space-y-6">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-2 h-6 bg-amber-500 rounded-full"></div>
          <h3 class="text-lg font-bold text-white uppercase tracking-wider text-sm">Textos Principales</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-widest px-1">Título</label>
            <input 
              type="text" 
              name="title" 
              value={hero.title}
              class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-amber-500 outline-none transition-all"
              required
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold text-stone-500 uppercase tracking-widest px-1">Subtítulo</label>
            <input 
              type="text" 
              name="subtitle" 
              value={hero.subtitle}
              class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-amber-500 outline-none transition-all"
              required
            />
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-xs font-bold text-stone-500 uppercase tracking-widest px-1">Descripción</label>
          <textarea 
            name="description" 
            rows="3"
            class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-amber-500 outline-none transition-all resize-none"
            required
          >{hero.description}</textarea>
        </div>
      </div>

      <!-- Call to Actions -->
      <div class="bg-stone-900 border border-stone-800 rounded-3xl p-8 space-y-6">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-2 h-6 bg-amber-500 rounded-full"></div>
          <h3 class="text-lg font-bold text-white uppercase tracking-wider text-sm">Botones (CTAs)</h3>
        </div>

        {hero.ctas.map((cta, index) => (
          <div class="p-6 bg-stone-950 rounded-2xl border border-stone-800 space-y-4">
            <p class="text-xs font-black text-amber-500 uppercase">Botón {index + 1}</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input 
                type="text" 
                name={`cta${index + 1}_text`} 
                placeholder="Texto del botón"
                value={cta.text}
                class="bg-stone-900 border border-stone-800 rounded-lg px-4 py-2 text-sm text-white focus:border-amber-500 outline-none"
              />
              <input 
                type="text" 
                name={`cta${index + 1}_href`} 
                placeholder="Enlace (ej: #services)"
                value={cta.href}
                class="bg-stone-900 border border-stone-800 rounded-lg px-4 py-2 text-sm text-white focus:border-amber-500 outline-none"
              />
            </div>
          </div>
        ))}
      </div>

      <!-- Stats -->
      <div class="bg-stone-900 border border-stone-800 rounded-3xl p-8 space-y-6">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-2 h-6 bg-amber-500 rounded-full"></div>
          <h3 class="text-lg font-bold text-white uppercase tracking-wider text-sm">Estadísticas (Stats)</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {hero.stats.map((stat, index) => (
            <div class="p-6 bg-stone-950 rounded-2xl border border-stone-800 space-y-3">
              <input 
                type="text" 
                name={`stat${index + 1}_value`} 
                placeholder="Valor (ej: 10+)"
                value={stat.value}
                class="w-full bg-stone-900 border border-stone-800 rounded-lg px-3 py-2 text-lg font-bold text-white text-center focus:border-amber-500 outline-none"
              />
              <input 
                type="text" 
                name={`stat${index + 1}_label`} 
                placeholder="Etiqueta"
                value={stat.label}
                class="w-full bg-stone-900 border border-stone-800 rounded-lg px-3 py-2 text-xs text-stone-500 text-center focus:border-amber-500 outline-none"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Submit -->
      <div class="flex justify-end">
        <button 
          type="submit"
          class="bg-amber-500 hover:bg-amber-600 text-stone-950 font-black py-4 px-10 rounded-2xl transition-all shadow-xl shadow-amber-500/10 hover:shadow-amber-500/20 active:scale-95"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
