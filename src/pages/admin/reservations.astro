---
// src/pages/admin/reservations.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import { Package, Clock, User, CheckCircle2, XCircle, Trash2 } from "lucide-react";

// 1. Validar que solo los admins vean esto
const { user } = Astro.locals;
if (!user || !user.isAdmin) {
  return Astro.redirect("/admin");
}

const supabase = createSupabaseClient(Astro.request, Astro.cookies);
let successMessage = "";
let errorMessage = "";

// 2. Manejo de acciones del Administrador (Entregar o Cancelar)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action") as string;
    const reservationId = formData.get("reservationId") as string;

    if (!reservationId) throw new Error("ID de reserva inválido.");

    if (action === "collect") {
      // Entregar Producto: descontar físicamente del stock de products y marcar collected
      const { data: resData, error: errFetchRes } = await supabase
        .from("product_reservations")
        .select("product_id, quantity, status")
        .eq("id", reservationId)
        .single();

      if (errFetchRes || !resData) throw new Error("No se pudo obtener la reserva.");
      if (resData.status !== "pending") throw new Error("La reserva ya ha sido procesada.");

      // Obtener el stock actual del producto
      const { data: prodData, error: errFetchProd } = await supabase
        .from("products")
        .select("stock")
        .eq("id", resData.product_id)
        .single();

      if (errFetchProd || !prodData) throw new Error("No se pudo obtener el stock del producto.");

      const newStock = Math.max(0, prodData.stock - resData.quantity);

      // Transacción manual: actualizar stock del producto
      const { error: errUpdateProd } = await supabase
        .from("products")
        .update({ stock: newStock })
        .eq("id", resData.product_id);

      if (errUpdateProd) throw errUpdateProd;

      // Actualizar estado de la reserva
      const { error: errUpdateRes } = await supabase
        .from("product_reservations")
        .update({ status: "collected" })
        .eq("id", reservationId);

      if (errUpdateRes) throw errUpdateRes;

      successMessage = "¡Apartado entregado con éxito! El stock base se ha actualizado.";
    } else if (action === "cancel") {
      // Cancelar / Liberar: simplemente pasar a cancelled (el stock disponible se recupera automáticamente)
      const { error: errCancelRes } = await supabase
        .from("product_reservations")
        .update({ status: "cancelled" })
        .eq("id", reservationId);

      if (errCancelRes) throw errCancelRes;
      successMessage = "Apartado cancelado. El stock ha sido liberado inmediatamente.";
    }

    return Astro.redirect("/admin/reservations?success=true");
  } catch (err: any) {
    console.error("Error processing reservation action:", err);
    errorMessage = err.message || "Ocurrió un error al procesar la solicitud.";
  }
}

// 3. Consultar listado de apartados
const { data: dbReservations } = await supabase
  .from("product_reservations")
  .select(`
    id,
    quantity,
    reserved_at,
    expires_at,
    status,
    profiles:user_id(full_name, email),
    products:product_id(id, name, category, price, stock)
  `)
  .order("reserved_at", { ascending: false });

const reservations = dbReservations || [];

const isSuccess = Astro.url.searchParams.get("success") === "true";
---
<AdminLayout title="Apartados de Productos">
  <div class="w-full space-y-8 text-zinc-700 dark:text-zinc-300 animate-in fade-in slide-in-from-bottom-4 duration-700">
    
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div>
        <h2 class="text-2xl font-black text-zinc-950 dark:text-white uppercase tracking-tight font-display">Apartados de Productos</h2>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1 font-medium">Gestiona el inventario apartado por los clientes</p>
      </div>
      <a href="/admin/products" class="bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-350 px-4 py-2.5 rounded-xl text-xs font-bold transition-all text-center shadow-xs">
        Gestionar Productos
      </a>
    </div>

    <!-- Mensajes de Estado -->
    {isSuccess && (
      <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-sm font-semibold flex items-center gap-2">
        <CheckCircle2 className="w-5 h-5 shrink-0" />
        ¡Los cambios se procesaron y guardaron correctamente!
      </div>
    )}

    {errorMessage && (
      <div class="p-4 rounded-2xl bg-red-500/10 border border-red-200 dark:border-red-500/20 text-red-600 dark:text-red-400 text-sm font-semibold flex items-center gap-2">
        <XCircle className="w-5 h-5 shrink-0" />
        {errorMessage}
      </div>
    )}

    {/* Listado de Apartados (Tarjetas Responsivas Híbridas) */}
    <div class="space-y-6">
      <h3 class="text-lg font-bold text-zinc-950 dark:text-white uppercase tracking-wider flex items-center gap-2 font-display">
        <Package class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
        Solicitudes Activas e Historial
      </h3>

      {reservations.length === 0 ? (
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-16 text-center text-zinc-400">
          <Package className="w-12 h-12 text-zinc-300 dark:text-zinc-700 mx-auto mb-4" />
          <p class="font-medium">No se han registrado apartados de productos en el sistema.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {reservations.map((res: any) => {
            const reservedDate = new Date(res.reserved_at).toLocaleDateString("es-MX", { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
            const expiresDateObj = new Date(res.expires_at);
            const now = new Date();
            const isPending = res.status === "pending";
            const isExpired = isPending && expiresDateObj < now;

            // Calcular tiempo restante para mostrar
            let timeLabel = "";
            if (isPending) {
              if (isExpired) {
                const hoursPast = Math.floor((now.getTime() - expiresDateObj.getTime()) / (1000 * 60 * 60));
                timeLabel = `Expirado hace ${hoursPast}h (Liberar Stock)`;
              } else {
                const timeLeft = expiresDateObj.getTime() - now.getTime();
                const daysLeft = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                const hoursLeft = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                timeLabel = daysLeft > 0 
                  ? `Vence en ${daysLeft}d y ${hoursLeft}h`
                  : `Vence en ${hoursLeft}h`;
              }
            }

            let statusBadge = "bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60";
            let statusLabel = res.status;
            if (res.status === "pending") {
              statusBadge = isExpired
                ? "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-500/20 animate-pulse"
                : "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-500/20";
              statusLabel = isExpired ? "Expirado" : "Pendiente";
            } else if (res.status === "collected") {
              statusBadge = "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20";
              statusLabel = "Entregado";
            } else if (res.status === "cancelled") {
              statusBadge = "bg-zinc-100 dark:bg-zinc-950 text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800";
              statusLabel = "Cancelado";
            }

            return (
              <div class={`bg-white dark:bg-zinc-900 border rounded-2xl p-6 flex flex-col justify-between gap-6 transition-all ${
                isExpired 
                  ? "border-red-200 dark:border-red-900/30 bg-red-50/50 dark:bg-red-950/5" 
                  : "border-zinc-200 dark:border-zinc-800/80 hover:border-indigo-500/50 dark:hover:border-indigo-500/40 hover:shadow-lg hover:shadow-indigo-500/5"
              }`}>
                {/* Cabecera de la Tarjeta */}
                <div class="flex items-start justify-between gap-4">
                  <div class="space-y-1">
                    <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-550 uppercase tracking-wider block">Apartado el</span>
                    <span class="text-sm font-bold text-zinc-950 dark:text-white block">{reservedDate}</span>
                  </div>
                  <div class="flex flex-col items-end gap-1.5 font-medium">
                    <span class={`px-2.5 py-1 text-3xs font-bold uppercase tracking-wider rounded-lg inline-flex items-center gap-1.5 ${statusBadge}`}>
                      <span class="w-1 h-1 rounded-full bg-current"></span>
                      {statusLabel}
                    </span>
                    {isPending && (
                      <span class={`text-3xs font-semibold flex items-center gap-1 mt-0.5 ${isExpired ? "text-red-600 dark:text-red-400 font-bold animate-pulse" : "text-amber-600 dark:text-amber-400"}`}>
                        <Clock class="w-3.5 h-3.5" />
                        {timeLabel}
                      </span>
                    )}
                  </div>
                </div>

                {/* Contenido: Cliente y Producto */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-b border-zinc-200 dark:border-zinc-800/60 py-4 text-xs">
                  {/* Cliente */}
                  <div class="space-y-1">
                    <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-550 uppercase tracking-wider block">Cliente</span>
                    <span class="font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-1.5">
                      <User class="w-3.5 h-3.5 text-zinc-400" />
                      {res.profiles?.full_name || "Usuario Desconocido"}
                    </span>
                    <span class="text-zinc-500 dark:text-zinc-400 text-3xs block pl-5 truncate max-w-xs">{res.profiles?.email}</span>
                  </div>

                  {/* Producto */}
                  <div class="space-y-1">
                    <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-550 uppercase tracking-wider block">Producto</span>
                    <span class="font-bold text-zinc-800 dark:text-zinc-200 block truncate">{res.products?.name || "Eliminado"}</span>
                    <span class="text-zinc-500 dark:text-zinc-400 text-3xs block">
                      Cant: <span class="font-bold text-zinc-900 dark:text-white">{res.quantity}</span> • 
                      Precio unitario: <span class="font-bold text-indigo-600 dark:text-indigo-400">
                        {res.products?.price ? (String(res.products.price).startsWith("$") ? res.products.price : `$${res.products.price}`) : "$0"}
                      </span>
                    </span>
                  </div>
                </div>

                {/* Acciones */}
                {isPending ? (
                  <form method="POST" class="grid grid-cols-2 gap-3">
                    <input type="hidden" name="reservationId" value={res.id} />
                    
                    <button
                      type="submit"
                      name="action"
                      value="collect"
                      disabled={isExpired}
                      class={`py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center cursor-pointer transition-all ${
                        isExpired 
                          ? "bg-zinc-100 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-400 cursor-not-allowed" 
                          : "bg-emerald-600 hover:bg-emerald-500 text-white shadow-xs"
                      }`}
                    >
                      Entregar Pedido
                    </button>
                    
                    <button
                      type="submit"
                      name="action"
                      value="cancel"
                      class={`py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center cursor-pointer border transition-all ${
                        isExpired
                          ? "bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-500/20"
                          : "bg-zinc-50 hover:bg-red-500/10 text-zinc-500 hover:text-red-600 dark:bg-zinc-950 dark:hover:bg-red-500/10 dark:text-zinc-400 dark:hover:text-red-400 border border-zinc-200 dark:border-zinc-800 hover:border-red-500/20"
                      }`}
                    >
                      {isExpired ? "Liberar Stock" : "Cancelar Apartado"}
                    </button>
                  </form>
                ) : (
                  <div class="text-center pt-1 text-3xs text-zinc-500 dark:text-zinc-500 font-bold uppercase tracking-wider italic">
                    {res.status === "collected" ? "Apartado recogido y cerrado" : "Apartado cancelado y liberado"}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</AdminLayout>
