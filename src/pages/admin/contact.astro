---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import {
  MapPin,
  Phone,
  Clock,
  Save,
  Plus,
  Trash2,
  CheckCircle2,
  X,
  Info,
} from "lucide-react";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

let errorMessage = "";
let successMessage = "";

const { data: contact } = await supabase
  .from("contact_info")
  .select("*")
  .eq("id", "default")
  .single();

const { data: dbSchedule } = await supabase
  .from("schedule_entries")
  .select("*")
  .order("sort_order", { ascending: true });

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    const action = formData.get("action");

    if (action === "update_contact") {
      const address = formData.get("address")?.toString();
      const phone = formData.get("phone")?.toString();
      const brand_name = formData.get("brand_name")?.toString();
      const brand_description = formData.get("brand_description")?.toString();

      const days = formData.getAll("schedule_days[]");
      const hours = formData.getAll("schedule_hours[]");

      const schedule = days
        .map((day, i) => ({
          days: day.toString(),
          hours: hours[i]?.toString() || "",
        }))
        .filter((item) => item.days && item.hours);

      const { error: contactError } = await supabase
        .from("contact_info")
        .upsert({
          id: "default",
          address,
          phone,
          brand_name,
          brand_description,
        });

      if (contactError) throw contactError;

      const { error: deleteError } = await supabase
        .from("schedule_entries")
        .delete()
        .neq("id", "00000000-0000-0000-0000-000000000000");

      if (deleteError) throw deleteError;

      const scheduleData = days
        .map((day, i) => ({
          days: day.toString(),
          hours: hours[i]?.toString() || "",
          sort_order: i + 1,
        }))
        .filter((item) => item.days && item.hours);

      const { error: scheduleError } = await supabase
        .from("schedule_entries")
        .insert(scheduleData);

      if (scheduleError) throw scheduleError;

      return Astro.redirect("/admin/contact?success=true");
    }
  } catch (e) {
    errorMessage = (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";
const currentContact = contact || {
  address: "",
  phone: "",
  brand_name: "Barber Ray",
  brand_description: "",
};

const currentSchedule = dbSchedule?.length
  ? dbSchedule
  : [{ days: "Lun – Vie", hours: "9:00am – 8:00pm" }];
---

<AdminLayout title="Configuración de Contacto">
  <div class="w-full space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <div class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <h2 class="text-2xl font-black text-zinc-900 dark:text-white uppercase tracking-tight font-display">
        Información del Negocio
      </h2>
      <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1 font-medium">
        Administra la ubicación, teléfonos y horarios de atención al cliente.
      </p>
    </div>

    {
      errorMessage && (
        <div class="p-4 bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 text-red-700 dark:text-red-400 rounded-2xl flex items-center gap-3 shadow-2xs animate-in fade-in duration-300">
          <X className="w-5 h-5 shrink-0" />
          <span class="font-medium text-sm">Error: {errorMessage}</span>
        </div>
      )
    }

    {
      isSuccess && (
        <div
          id="success-notification"
          class="p-4 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 rounded-2xl flex items-center justify-between animate-in fade-in slide-in-from-top-4 shadow-2xs"
        >
          <div class="flex items-center gap-3">
            <CheckCircle2 className="w-5 h-5 shrink-0" />
            <span class="font-medium text-sm">
              Los cambios se han guardado y publicado correctamente.
            </span>
          </div>
          <button
            onclick="document.getElementById('success-notification').style.display='none'"
            class="cursor-pointer p-1.5 hover:bg-emerald-100 dark:hover:bg-emerald-500/20 rounded-lg transition-colors"
          >
            <X className="w-4 h-4" />
          </button>
        </div>
      )
    }

    <form method="POST" class="space-y-8">
      <input type="hidden" name="action" value="update_contact" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-8">
          <div
            class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 space-y-6 shadow-xs"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-indigo-50 dark:bg-indigo-500/10 rounded-xl flex items-center justify-center text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-500/20 shadow-2xs"
              >
                <Info className="w-5 h-5" />
              </div>
              <h3
                class="text-zinc-900 dark:text-zinc-100 font-black uppercase tracking-widest text-2xs font-display"
              >
                Identidad y Contacto
              </h3>
            </div>

            <div class="space-y-4">
              <div class="space-y-2">
                <label
                  class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4"
                  >Nombre de la Marca</label
                >
                <input
                  type="text"
                  name="brand_name"
                  value={currentContact.brand_name}
                  placeholder="Ej. Barber Ray"
                  class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl px-6 py-4 text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm shadow-2xs"
                  required
                />
              </div>

              <div class="space-y-2">
                <label
                  class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4"
                  >Descripción (Footer)</label
                >
                <textarea
                  name="brand_description"
                  rows="3"
                  placeholder="Descripción corta de la marca para el footer..."
                  class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl px-6 py-4 text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-500 transition-colors resize-none text-sm shadow-2xs"
                  required>{currentContact.brand_description}</textarea
                >
              </div>

              <div class="space-y-2">
                <label
                  class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4"
                  >Dirección Física</label
                >
                <div class="relative">
                  <MapPin
                    className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400 dark:text-zinc-600"
                  />
                  <input
                    type="text"
                    name="address"
                    value={currentContact.address}
                    placeholder="Ej. Av. Reforma 123, CDMX"
                    class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl pl-12 pr-6 py-4 text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm shadow-2xs"
                    required
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label
                  class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4"
                  >Teléfono de Atención</label
                >
                <div class="relative">
                  <Phone
                    className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400 dark:text-zinc-600"
                  />
                  <input
                    type="text"
                    name="phone"
                    value={currentContact.phone}
                    placeholder="Ej. +52 55 1234 5678"
                    class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl pl-12 pr-6 py-4 text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm shadow-2xs"
                    required
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 shadow-xs">
            <div class="flex items-center justify-between mb-8">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 bg-indigo-50 dark:bg-indigo-500/10 rounded-xl flex items-center justify-center text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-500/20 shadow-2xs"
                >
                  <Clock className="w-5 h-5" />
                </div>
                <h3
                  class="text-zinc-900 dark:text-zinc-100 font-black uppercase tracking-widest text-2xs font-display"
                >
                  Gestión de Horarios
                </h3>
              </div>
              <button
                type="button"
                id="add-schedule-btn"
                class="cursor-pointer p-2 bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-500/20 rounded-xl hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 dark:hover:text-white transition-all shadow-2xs"
              >
                <Plus className="w-5 h-5" />
              </button>
            </div>

            <div id="schedule-container" class="space-y-4">
              {
                currentSchedule.map((item: any, index: number) => (
                  <div
                    class="flex gap-4 items-end group animate-in fade-in slide-in-from-right-4"
                    style={`animation-delay: ${index * 50}ms`}
                  >
                    <div class="flex-1 space-y-2">
                      {index === 0 && (
                        <label class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4">
                          Días
                        </label>
                      )}
                      <input
                        type="text"
                        name="schedule_days[]"
                        value={item.days}
                        placeholder="Lun - Vie"
                        class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-500 transition-colors shadow-2xs"
                        required
                      />
                    </div>
                    <div class="flex-1 space-y-2">
                      {index === 0 && (
                        <label class="text-3xs font-black text-zinc-400 dark:text-zinc-500 uppercase tracking-wider ml-4">
                          Horas
                        </label>
                      )}
                      <input
                        type="text"
                        name="schedule_hours[]"
                        value={item.hours}
                        placeholder="9:00am - 8:00pm"
                        class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-500 transition-colors shadow-2xs"
                        required
                      />
                    </div>
                    {index > 0 && (
                      <button
                        type="button"
                        onclick="this.parentElement.remove()"
                        class="cursor-pointer p-3 text-zinc-400 hover:text-red-650 dark:hover:text-red-500 transition-colors"
                      >
                        <Trash2 className="w-5 h-5" />
                      </button>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end pt-4 w-full">
        <button
          type="submit"
          class="cursor-pointer w-full sm:w-auto justify-center bg-indigo-600 hover:bg-indigo-750 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-bold px-10 py-3.5 rounded-xl transition-all flex items-center gap-3 shadow-xs hover:shadow-md active:scale-98 group uppercase text-sm tracking-wider font-display"
        >
          <Save
            className="w-5 h-5 group-hover:scale-110 transition-transform text-white"
          />
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>

  <script>
    const container = document.getElementById("schedule-container");
    const addBtn = document.getElementById("add-schedule-btn");

    addBtn?.addEventListener("click", () => {
      const row = document.createElement("div");
      row.className =
        "flex gap-4 items-end group animate-in fade-in slide-in-from-right-4";
      row.innerHTML = `
        <div class="flex-1 space-y-2">
          <input 
            type="text" 
            name="schedule_days[]"
            placeholder="Días"
            class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-500 transition-colors shadow-2xs"
            required
          />
        </div>
        <div class="flex-1 space-y-2">
          <input 
            type="text" 
            name="schedule_hours[]"
            placeholder="Horario"
            class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-500 transition-colors shadow-2xs"
            required
          />
        </div>
        <button 
          type="button"
          onclick="this.parentElement.remove()"
          class="cursor-pointer p-3 text-zinc-400 hover:text-red-650 dark:hover:text-red-500 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </button>
      `;
      container?.appendChild(row);
    });
  </script>
</AdminLayout>
