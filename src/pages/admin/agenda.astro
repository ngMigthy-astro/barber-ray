---
// src/pages/admin/agenda.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import type { AgendaAppointment, AppointmentStatus } from "../../interfaces/admin/agenda.interface";

// 1. Validamos que solo los admins vean esto (Astro Middleware debería atraparlo, pero por si acaso)
const { user } = Astro.locals;
if (!user) return Astro.redirect("/admin");

// 2. Instanciamos Supabase con el entorno del request
const supabase = createSupabaseClient(Astro.request, Astro.cookies);

// Manejo de acciones POST para cambiar estado de citas (PRG Pattern)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const appointmentId = formData.get("appointmentId") as string;
    const newStatus = formData.get("status") as AppointmentStatus;

    if (appointmentId && newStatus) {
      const { error: updateError } = await supabase
        .from("appointments")
        .update({ status: newStatus })
        .eq("id", appointmentId);

      if (updateError) throw updateError;
    }
  } catch (err) {
    console.error("Error updating appointment:", err);
  }
  return Astro.redirect(Astro.url.pathname);
}

// 3. Traemos las citas. 
// Traemos citas futuras y citas pasadas no resueltas (pending o confirmed)
const todayStr = new Date(new Date().setHours(0, 0, 0, 0)).toISOString();
const { data: rawAppointments, error } = await supabase
  .from("appointments")
  .select(`
    id,
    user_id,
    appointment_date,
    status,
    client_name,
    client_phone,
    profiles:user_id(full_name, email),
    service:service_id(name, duration, price),
    barber:barber_id(name)
  `)
  .or(`appointment_date.gte.${todayStr},status.in.(pending,confirmed)`)
  .order("appointment_date", { ascending: true });

// 4. Transformamos (Mapeo) el objeto crudo de DB a nuestra Interfaz limpia (SRP)
const appointments: AgendaAppointment[] = (rawAppointments || []).map((app: any) => ({
  id: app.id,
  user_id: app.user_id,
  client_name: app.client_name || app.profiles?.full_name || "Cliente Desconocido",
  client_email: app.profiles?.email,
  client_phone: app.client_phone,
  service: app.service,
  barber: app.barber,
  appointment_date: app.appointment_date,
  status: app.status
}));
---

<AdminLayout title="Agenda Semanal">
  <div class="max-w-6xl mx-auto space-y-8 text-stone-300 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-white uppercase tracking-tight">
          Citas Agendadas
        </h2>
        <p class="text-stone-500 text-sm mt-1 font-medium italic">
          Administra las reservaciones de tus clientes
        </p>
      </div>
      <div>
        <a
          href="/admin/book"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-stone-950 font-black text-xs px-5 py-3 rounded-xl transition-all cursor-pointer shadow-lg shadow-amber-500/10 hover:shadow-amber-500/20 uppercase tracking-wider"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
          Agendar Cita Manual
        </a>
      </div>
    </div>

    <div class="bg-stone-900 border border-stone-800 rounded-3xl overflow-hidden shadow-2xl relative">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-stone-950/50 border-b border-stone-800">
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra whitespace-nowrap">Fecha & Hora</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Cliente</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Servicio</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Barbero</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra whitespace-nowrap">Estado</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-800/50">
            {appointments.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-16 text-center text-stone-500">
                  <div class="flex flex-col items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-stone-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    <p class="font-medium">No hay citas agendadas próximamente.</p>
                  </div>
                </td>
              </tr>
            ) : (
              appointments.map((app) => {
                const dateObj = new Date(app.appointment_date);
                const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
                const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });
                
                const isPast = dateObj < new Date();
                const needsAction = isPast && (app.status === 'pending' || app.status === 'confirmed');
                
                let badgeClass = "bg-stone-800 text-stone-400 border border-stone-700";
                // statusText es la etiqueta visual (español), distinta al valor de dominio (inglés)
                let statusText: string = app.status;
                
                if (app.status === 'pending') {
                  badgeClass = "bg-amber-500/10 text-amber-500 border border-amber-500/20";
                  statusText = "Pendiente";
                } else if (app.status === 'confirmed') {
                  badgeClass = "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20";
                  statusText = "Confirmada";
                } else if (app.status === 'cancelled') {
                  badgeClass = "bg-red-500/10 text-red-500 border border-red-500/20";
                  statusText = "Cancelada";
                } else if (app.status === 'completed') {
                  badgeClass = "bg-blue-500/10 text-blue-500 border border-blue-500/20";
                  statusText = "Completada";
                }

                return (
                  <tr class={`hover:bg-stone-800/40 transition-colors group ${needsAction ? "bg-red-500/[0.02]" : ""}`}>
                    <td class="px-6 py-5 whitespace-nowrap">
                      <div class="flex flex-col">
                        <span class="font-bold text-white capitalize text-sm">{dateStr}</span>
                        <span class="text-xs text-amber-500 font-bold mt-0.5">{timeStr}</span>
                      </div>
                    </td>
                    <td class="px-6 py-5">
                      <div class="flex flex-col">
                        <span class="font-bold text-white text-sm">{app.client_name}</span>
                        <span class="text-xs text-stone-500 mt-0.5">
                          {app.client_email || "Sin email registrado"}
                          {app.client_phone && <span class="text-stone-600 ml-1.5">• {app.client_phone}</span>}
                        </span>
                      </div>
                    </td>
                    <td class="px-6 py-5">
                      <div class="flex flex-col">
                        <span class="font-medium text-stone-300 text-sm">{app.service?.name || "N/A"}</span>
                        <span class="text-xs text-stone-500 mt-0.5">
                          {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "-"} • 
                          <span class="font-bold">
                            {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                          </span>
                        </span>
                      </div>
                    </td>
                    <td class="px-6 py-5 whitespace-nowrap">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-stone-950 border border-stone-800 flex items-center justify-center text-xs font-black text-amber-500 shadow-inner">
                          {app.barber?.name?.charAt(0) || "?"}
                        </div>
                        <span class="text-sm font-medium text-stone-300">{app.barber?.name || "Sin Asignar"}</span>
                      </div>
                    </td>
                    <td class="px-6 py-5 whitespace-nowrap">
                      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                        <span class={`px-3 py-1.5 text-2xs font-black uppercase tracking-ultra rounded-lg inline-flex items-center gap-2 ${badgeClass}`}>
                          <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                          {statusText}
                        </span>
                        {needsAction && (
                          <span class="px-2 py-1 bg-red-500/10 text-red-500 border border-red-500/20 text-[9px] font-black uppercase tracking-wider rounded-md animate-pulse">
                            ⚠️ Resolver cita
                          </span>
                        )}
                      </div>
                    </td>
                    <td class="px-6 py-5 whitespace-nowrap text-right">
                      {app.status === 'pending' || app.status === 'confirmed' ? (
                        <form method="POST" class="inline-flex gap-2 justify-end">
                          <input type="hidden" name="appointmentId" value={app.id} />
                          
                          {app.status === 'pending' && (
                            <button
                              type="submit"
                              name="status"
                              value="confirmed"
                              class="px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider rounded-lg bg-amber-500 hover:bg-amber-600 text-stone-950 transition-colors shadow-md hover:shadow-amber-500/10 cursor-pointer"
                            >
                              Confirmar
                            </button>
                          )}
                          
                          <button
                            type="submit"
                            name="status"
                            value="completed"
                            class="px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider rounded-lg bg-emerald-500 hover:bg-emerald-600 text-stone-950 transition-colors shadow-md hover:shadow-emerald-500/10 cursor-pointer"
                          >
                            Completar
                          </button>
                          
                          <button
                            type="submit"
                            name="status"
                            value="cancelled"
                            class="px-2.5 py-1.5 text-[10px] font-black uppercase tracking-wider rounded-lg bg-stone-900 hover:bg-red-500/20 text-stone-400 hover:text-red-400 border border-stone-800 hover:border-red-500/30 transition-all cursor-pointer"
                          >
                            {isPast ? "Inasistencia" : "Cancelar"}
                          </button>
                        </form>
                      ) : (
                        <span class="text-xs text-stone-600 font-bold uppercase tracking-wider italic">
                          Cerrada
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
