---
// src/pages/admin/agenda.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import type { AgendaAppointment, AppointmentStatus } from "../../interfaces/admin/agenda.interface";

// 1. Validamos que solo los admins vean esto (Astro Middleware debería atraparlo, pero por si acaso)
const { user } = Astro.locals;
if (!user) return Astro.redirect("/admin");

// 2. Instanciamos Supabase con el entorno del request
const supabase = createSupabaseClient(Astro.request, Astro.cookies);

// Manejo de acciones POST para cambiar estado de citas (PRG Pattern)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const appointmentId = formData.get("appointmentId") as string;
    const newStatus = formData.get("status") as AppointmentStatus;

    if (appointmentId && newStatus) {
      const { error: updateError } = await supabase
        .from("appointments")
        .update({ status: newStatus })
        .eq("id", appointmentId);

      if (updateError) throw updateError;
    }
  } catch (err) {
    console.error("Error updating appointment:", err);
  }
  return Astro.redirect(Astro.url.pathname);
}

// 3. Traemos las citas.
// Regla: citas futuras (cualquier status) + citas pasadas no resueltas (pending/confirmed)
// Queremos ver las canceladas por el usuario en el admin para tener visibilidad completa.
const todayStr = new Date(new Date().setHours(0, 0, 0, 0)).toISOString();
const { data: rawAppointments, error } = await supabase
  .from("appointments")
  .select(`
    id,
    user_id,
    appointment_date,
    status,
    client_name,
    client_phone,
    profiles:user_id(full_name, email),
    service:service_id(name, duration, price),
    barber:barber_id(name)
  `)
  // Futuras (cualquier estado, para ver canceladas también) OR pasadas sin resolver
  .or(
    `appointment_date.gte.${todayStr},` +
    `and(appointment_date.lt.${todayStr},status.in.(pending,confirmed))`
  )
  .order("appointment_date", { ascending: true });

// 4. Transformamos (Mapeo) el objeto crudo de DB a nuestra Interfaz limpia (SRP)
const appointments: AgendaAppointment[] = (rawAppointments || []).map((app: any) => ({
  id: app.id,
  user_id: app.user_id,
  client_name: app.client_name || app.profiles?.full_name || "Cliente Desconocido",
  client_email: app.profiles?.email,
  client_phone: app.client_phone,
  service: app.service,
  barber: app.barber,
  appointment_date: app.appointment_date,
  status: app.status
}));
---
<AdminLayout title="Agenda Semanal">
  {(() => {
    const pendingCount = appointments.filter(a => a.status === 'pending').length;
    const confirmedCount = appointments.filter(a => a.status === 'confirmed').length;
    const cancelledCount = appointments.filter(a => a.status === 'cancelled').length;
    return (
      <div class="w-full space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">

        {/* ── Header ── */}
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <div class="flex items-start gap-4">
            {/* Línea decorativa indigo */}
            <div class="w-1 h-14 rounded-full bg-gradient-to-b from-indigo-400 to-indigo-600 shrink-0 mt-1 shadow-md shadow-indigo-500/20"></div>
            <div>
              <p class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-1">Panel de Control</p>
              <h1 class="text-3xl font-black text-zinc-950 dark:text-white uppercase tracking-tight leading-none font-display">Agenda</h1>
              <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1.5 font-medium">Administra las reservaciones de tus clientes</p>
            </div>
          </div>

          {/* Stat chips + CTA */}
          <div class="flex flex-wrap items-center gap-3">
            <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-700 dark:text-amber-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider">{pendingCount} Pendientes</span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-bold uppercase tracking-wider">{confirmedCount} Confirmadas</span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-red-500/10 border border-red-200 dark:border-red-500/20 text-red-600 dark:text-red-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              <span class="text-xs font-bold uppercase tracking-wider">{cancelledCount} Canceladas</span>
            </div>
            <a
              href="/admin/book"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-5 py-3 rounded-2xl transition-all duration-200 cursor-pointer shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/30 uppercase tracking-wider hover:scale-[1.02] active:scale-[0.98]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
              Agendar Cita Manual
            </a>
          </div>
        </div>

        {/* ── Table / Cards container ── */}
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl overflow-hidden shadow-xs relative">

          {/* ── Desktop Table ── */}
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-zinc-50 dark:bg-zinc-950/40 border-b border-zinc-200 dark:border-zinc-800/80">
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider whitespace-nowrap">Fecha & Hora</th>
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Cliente</th>
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Servicio</th>
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Barbero</th>
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider whitespace-nowrap">Estado</th>
                  <th class="px-5 py-4 lg:px-7 lg:py-5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-200/60 dark:divide-zinc-800/40">
                {appointments.length === 0 ? (
                  <tr>
                    <td colspan="6" class="px-6 py-20 text-center">
                      <div class="flex flex-col items-center gap-4">
                        <div class="w-16 h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/50 flex items-center justify-center text-zinc-400">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        </div>
                        <div>
                          <p class="font-bold text-zinc-800 dark:text-zinc-200 text-sm">Sin citas próximas</p>
                          <p class="text-zinc-500 dark:text-zinc-500 text-xs mt-1">La agenda está tranquila hoy. ¡A buscar clientes!</p>
                        </div>
                      </div>
                    </td>
                  </tr>
                ) : (
                  appointments.map((app) => {
                    const dateObj = new Date(app.appointment_date);
                    const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
                    const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });
                    const isPast = dateObj < new Date();
                    const needsAction = isPast && (app.status === 'pending' || app.status === 'confirmed');
                    const initial = app.client_name?.charAt(0).toUpperCase() || "?";

                    let badgeClass = "bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60";
                    let statusText: string = app.status;
                    let dotColor = "bg-zinc-400";

                    if (app.status === 'pending') {
                      badgeClass = "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-500/20";
                      statusText = "Pendiente";
                      dotColor = "bg-amber-400";
                    } else if (app.status === 'confirmed') {
                      badgeClass = "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-500/20";
                      statusText = "Confirmada";
                      dotColor = "bg-emerald-400";
                    } else if (app.status === 'cancelled') {
                      badgeClass = "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-500/20";
                      statusText = "Cancelada";
                      dotColor = "bg-red-400";
                    } else if (app.status === 'completed') {
                      badgeClass = "bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-500/20";
                      statusText = "Completada";
                      dotColor = "bg-indigo-500";
                    }

                    return (
                      <tr class={`group transition-all duration-200 ease-in-out ${
                        app.status === 'cancelled'
                          ? "opacity-65 dark:opacity-40 hover:opacity-90 dark:hover:opacity-60"
                          : `hover:bg-zinc-50/50 dark:hover:bg-zinc-800/20 ${needsAction ? "ring-1 ring-inset ring-amber-500/20" : ""}`
                      }`}>
                        {/* Fecha & Hora */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5 whitespace-nowrap">
                          <div class="inline-flex flex-col bg-indigo-50 dark:bg-indigo-500/10 rounded-xl px-3 py-2">
                            <span class="font-bold text-zinc-900 dark:text-white capitalize text-sm leading-tight">{dateStr}</span>
                            <span class="text-xs text-indigo-600 dark:text-indigo-400 font-extrabold mt-0.5">{timeStr}</span>
                          </div>
                        </td>

                        {/* Cliente */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5">
                          <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-sm font-bold text-indigo-600 dark:text-indigo-400 shrink-0">
                              {initial}
                            </div>
                            <div class="flex flex-col min-w-0">
                              <span class="font-bold text-zinc-900 dark:text-white text-sm whitespace-nowrap">{app.client_name}</span>
                              <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 block truncate max-w-[140px]" title={app.client_email || "Sin email registrado"}>
                                {app.client_email || "Sin email"}
                              </span>
                              {app.client_phone && (
                                <span class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5 block whitespace-nowrap">
                                  {app.client_phone}
                                </span>
                              )}
                            </div>
                          </div>
                        </td>

                        {/* Servicio */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5">
                          <div class="flex flex-col">
                            <span class="font-semibold text-zinc-850 dark:text-zinc-200 text-sm whitespace-nowrap">{app.service?.name || "N/A"}</span>
                            <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 block whitespace-nowrap">
                              {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "-"}
                              <span class="mx-1 text-zinc-300 dark:text-zinc-700">•</span>
                              <span class="font-bold text-zinc-900 dark:text-indigo-400">
                                {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                              </span>
                            </span>
                          </div>
                        </td>

                        {/* Barbero */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5 whitespace-nowrap">
                          <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-zinc-150 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-bold text-zinc-700 dark:text-zinc-300">
                              {app.barber?.name?.charAt(0) || "?"}
                            </div>
                            <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300 whitespace-nowrap">{app.barber?.name || "Sin Asignar"}</span>
                          </div>
                        </td>

                        {/* Estado */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5 whitespace-nowrap">
                          <div class="flex flex-col items-start gap-1.5">
                            <span class={`px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl inline-flex items-center gap-2 ${badgeClass}`}>
                              <span class={`w-1.5 h-1.5 rounded-full ${dotColor} ${app.status !== 'completed' && app.status !== 'cancelled' ? 'animate-pulse' : ''}`}></span>
                              {statusText}
                            </span>
                            {needsAction && (
                              <span class="px-2 py-1 bg-amber-500/10 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 dark:border-amber-500/20 text-[9px] font-bold uppercase tracking-wider rounded-lg animate-pulse">
                                ⚡ Resolver
                              </span>
                            )}
                          </div>
                        </td>

                        {/* Acciones */}
                        <td class="px-5 py-4 lg:px-7 lg:py-5 whitespace-nowrap text-right">
                          {app.status === 'pending' || app.status === 'confirmed' ? (
                            <form method="POST" class="inline-flex gap-2 justify-end">
                              <input type="hidden" name="appointmentId" value={app.id} />

                              {app.status === 'pending' && (
                                <button
                                  type="submit"
                                  name="status"
                                  value="confirmed"
                                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-indigo-600 hover:bg-indigo-750 text-white transition-all shadow-xs cursor-pointer hover:scale-[1.03] active:scale-[0.97]"
                                >
                                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                  Confirmar
                                </button>
                              )}

                              <button
                                type="submit"
                                name="status"
                                value="completed"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition-all shadow-xs cursor-pointer hover:scale-[1.03] active:scale-[0.97]"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                Completar
                              </button>

                              <button
                                type="submit"
                                name="status"
                                value="cancelled"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-transparent text-zinc-500 hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-400 dark:hover:text-red-400 border border-zinc-200 dark:border-zinc-800 hover:border-red-500/20 transition-all duration-200 cursor-pointer hover:scale-[1.03] active:scale-[0.97]"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
                                {isPast ? "Inasistencia" : "Cancelar"}
                              </button>
                            </form>
                          ) : app.status === 'cancelled' ? (
                            <span class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-red-50 dark:bg-red-500/10 text-red-650 dark:text-red-400 border border-red-200 dark:border-red-500/20 inline-flex items-center gap-1.5">
                              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                              Cancelada por usuario
                            </span>
                          ) : (
                            <span class="text-xs text-zinc-500 dark:text-zinc-500 font-bold uppercase tracking-wider italic">
                              Cerrada
                            </span>
                          )}
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>

          {/* ── Mobile Cards ── */}
          <div class="block md:hidden divide-y divide-zinc-200/60 dark:divide-zinc-800/40">
            {appointments.length === 0 ? (
              <div class="px-6 py-20 text-center">
                <div class="flex flex-col items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/50 flex items-center justify-center text-zinc-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-800 dark:text-zinc-200 text-sm">Sin citas próximas</p>
                    <p class="text-zinc-500 dark:text-zinc-500 text-xs mt-1">La agenda está tranquila hoy. ¡A buscar clientes!</p>
                  </div>
                </div>
              </div>
            ) : (
              appointments.map((app) => {
                const dateObj = new Date(app.appointment_date);
                const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
                const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });
                const isPast = dateObj < new Date();
                const needsAction = isPast && (app.status === 'pending' || app.status === 'confirmed');
                const initial = app.client_name?.charAt(0).toUpperCase() || "?";

                let badgeClass = "bg-zinc-100 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60";
                let statusText: string = app.status;
                let dotColor = "bg-zinc-400";

                if (app.status === 'pending') {
                  badgeClass = "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-500/20";
                  statusText = "Pendiente";
                  dotColor = "bg-amber-400";
                } else if (app.status === 'confirmed') {
                  badgeClass = "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-500/20";
                  statusText = "Confirmada";
                  dotColor = "bg-emerald-400";
                } else if (app.status === 'cancelled') {
                  badgeClass = "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-500/20";
                  statusText = "Cancelada";
                  dotColor = "bg-red-400";
                } else if (app.status === 'completed') {
                  badgeClass = "bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-500/20";
                  statusText = "Completada";
                  dotColor = "bg-indigo-500";
                }

                return (
                  <div class={`mx-0 p-5 space-y-4 transition-all duration-200 ${
                    app.status === 'cancelled'
                      ? "opacity-65 dark:opacity-40 hover:opacity-90 dark:hover:opacity-60"
                      : needsAction
                        ? "ring-1 ring-inset ring-amber-500/20 hover:bg-zinc-50/50 dark:hover:bg-zinc-800/10"
                        : "hover:bg-zinc-50/50 dark:hover:bg-zinc-800/10"
                  }`}>

                    {/* Card header: fecha + status */}
                    <div class="flex items-start justify-between gap-3">
                      <div class="inline-flex items-center gap-3">
                        {/* Avatar */}
                        <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-sm font-bold text-indigo-600 dark:text-indigo-400 shrink-0">
                          {initial}
                        </div>
                        <div>
                          <span class="font-bold text-zinc-900 dark:text-white text-sm block leading-tight">{app.client_name}</span>
                          <div class="inline-flex items-center gap-2 bg-indigo-50 dark:bg-indigo-500/10 rounded-lg px-2.5 py-1 mt-1">
                            <span class="font-bold text-zinc-700 dark:text-zinc-300 capitalize text-xs">{dateStr}</span>
                            <span class="text-indigo-600 dark:text-indigo-400 font-extrabold text-xs">{timeStr}</span>
                          </div>
                        </div>
                      </div>
                      <div class="flex flex-col items-end gap-1.5 shrink-0">
                        <span class={`px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-xl inline-flex items-center gap-1.5 ${badgeClass}`}>
                          <span class={`w-1.5 h-1.5 rounded-full ${dotColor} ${app.status !== 'completed' && app.status !== 'cancelled' ? 'animate-pulse' : ''}`}></span>
                          {statusText}
                        </span>
                        {needsAction && (
                          <span class="px-2 py-0.5 bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[9px] font-bold uppercase tracking-wider rounded-lg animate-pulse">
                            ⚡ Resolver
                          </span>
                        )}
                      </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 bg-zinc-50/50 dark:bg-zinc-950/20 border border-zinc-100 dark:border-zinc-800/40 rounded-2xl p-3">
                      <div>
                        <span class="text-[9px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block">Servicio</span>
                        <span class="font-bold text-zinc-850 dark:text-zinc-200 block mt-0.5 text-sm">{app.service?.name || "N/A"}</span>
                        <span class="text-zinc-500 dark:text-zinc-400 text-xs mt-0.5 block">
                          {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "-"}
                          <span class="text-indigo-600 dark:text-indigo-400 font-bold ml-1">
                            {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                          </span>
                        </span>
                      </div>
                      <div>
                        <span class="text-[9px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block">Barbero</span>
                        <div class="flex items-center gap-1.5 mt-0.5">
                          <div class="w-6 h-6 rounded-lg bg-zinc-150 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-[10px] font-bold text-zinc-700 dark:text-zinc-300">
                            {app.barber?.name?.charAt(0) || "?"}
                          </div>
                          <span class="font-bold text-zinc-800 dark:text-zinc-250 text-sm">{app.barber?.name || "Sin Asignar"}</span>
                        </div>
                      </div>
                      {app.client_email && (
                        <div class="col-span-2">
                           <span class="text-[9px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block">Contacto</span>
                          <span class="text-zinc-700 dark:text-zinc-400 text-xs mt-0.5 block truncate">{app.client_email}</span>
                          {app.client_phone && <span class="text-zinc-550 dark:text-zinc-500 text-xs block">{app.client_phone}</span>}
                        </div>
                      )}
                    </div>

                    {/* Acciones */}
                    {app.status === 'pending' || app.status === 'confirmed' ? (
                      <form method="POST" class="grid grid-cols-3 gap-2">
                        <input type="hidden" name="appointmentId" value={app.id} />

                        {app.status === 'pending' ? (
                          <button
                            type="submit"
                            name="status"
                            value="confirmed"
                            class="inline-flex items-center justify-center gap-1 py-2.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-indigo-600 hover:bg-indigo-750 text-white transition-all shadow-xs cursor-pointer hover:scale-[1.02] active:scale-[0.98]"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            Confirmar
                          </button>
                        ) : (
                          <div></div>
                        )}

                        <button
                          type="submit"
                          name="status"
                          value="completed"
                          class="inline-flex items-center justify-center gap-1 py-2.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-emerald-600 text-white hover:bg-emerald-500 transition-all shadow-xs cursor-pointer hover:scale-[1.02] active:scale-[0.98]"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                          Completar
                        </button>

                        <button
                          type="submit"
                          name="status"
                          value="cancelled"
                          class="inline-flex items-center justify-center gap-1 py-2.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-transparent text-zinc-500 border border-zinc-200 dark:border-zinc-800 hover:bg-red-500/10 hover:text-red-450 hover:border-red-500/30 transition-all cursor-pointer hover:scale-[1.02] active:scale-[0.98]"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
                          {isPast ? "Inasistencia" : "Cancelar"}
                        </button>
                      </form>
                    ) : app.status === 'cancelled' ? (
                      <div class="flex justify-center pt-1">
                        <span class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-xl bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20 inline-flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                          Cancelada por usuario
                        </span>
                      </div>
                    ) : (
                      <div class="text-center pt-1 border-t border-zinc-200/40 dark:border-zinc-800/40">
                        <span class="text-[10px] text-zinc-500 font-bold uppercase tracking-wider italic">Cerrada</span>
                      </div>
                    )}
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    );
  })()}
</AdminLayout>

<style>
  /* Custom scrollbar for the table wrapper — sleek & premium */
  .overflow-x-auto {
    scrollbar-width: thin;
    scrollbar-color: var(--color-zinc-400) transparent;
  }

  .overflow-x-auto::-webkit-scrollbar {
    height: 6px;
  }

  .overflow-x-auto::-webkit-scrollbar-track {
    background: transparent;
  }

  .overflow-x-auto::-webkit-scrollbar-thumb {
    background-color: #d4d4d8; /* zinc-300 light */
    border-radius: 20px;
  }

  :global(.dark) .overflow-x-auto::-webkit-scrollbar-thumb {
    background-color: #27272a; /* zinc-800 dark */
    border-radius: 20px;
  }
</style>
