---
// src/pages/admin/history.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import type { AgendaAppointment, AppointmentStatus } from "../../interfaces/admin/agenda.interface";

// 1. Validaciones de sesión de Administrador
const { user } = Astro.locals;
if (!user) return Astro.redirect("/admin");

const supabase = createSupabaseClient(Astro.request, Astro.cookies);

// 2. Parámetros de filtros y paginación desde la URL
const url = Astro.url;
const search = url.searchParams.get("search") || "";
const status = url.searchParams.get("status") || "all";
const barberId = url.searchParams.get("barberId") || "all";
const page = parseInt(url.searchParams.get("page") || "1", 10);
const limit = 10;
const offset = (page - 1) * limit;

// 3. Traer Barberos para el filtro dropdown
const { data: barbers } = await supabase
  .from("team_members")
  .select("id, name")
  .order("name", { ascending: true });

// 4. Búsqueda de clientes por nombre o email si se provee
let userIds: string[] = [];
let hasSearch = false;
if (search.trim()) {
  hasSearch = true;
  const { data: matchedProfiles } = await supabase
    .from("profiles")
    .select("id")
    .or(`full_name.ilike.%${search}%,email.ilike.%${search}%`);
  userIds = (matchedProfiles || []).map((p: any) => p.id);
}

// 5. Construcción de Query de Citas con PostgREST
let query = supabase
  .from("appointments")
  .select(`
    id,
    user_id,
    appointment_date,
    status,
    client_name,
    client_phone,
    profiles:user_id(full_name, email),
    service:service_id(name, duration, price),
    barber:barber_id(name)
  `, { count: "exact" });

// Filtro de búsqueda por cliente (soporta cuentas de usuario y nombres manuales)
if (hasSearch) {
  if (userIds.length > 0) {
    query = query.or(`user_id.in.(${userIds.join(",")}),client_name.ilike.%${search}%`);
  } else {
    query = query.ilike("client_name", `%${search}%`);
  }
}

// Filtro de estado
if (status !== "all") {
  query = query.eq("status", status);
}

// Filtro de barbero
if (barberId !== "all") {
  query = query.eq("barber_id", barberId);
}

// Paginación y orden (mostrando las más recientes primero para ver el historial activo)
query = query
  .order("appointment_date", { ascending: false })
  .range(offset, offset + limit - 1);

const { data: rawAppointments, error, count } = await query;

const appointments: AgendaAppointment[] = (rawAppointments || []).map((app: any) => ({
  id: app.id,
  user_id: app.user_id,
  client_name: app.client_name || app.profiles?.full_name || "Cliente Desconocido",
  client_email: app.profiles?.email,
  client_phone: app.client_phone,
  service: app.service,
  barber: app.barber,
  appointment_date: app.appointment_date,
  status: app.status
}));

const totalCount = count || 0;
const totalPages = Math.ceil(totalCount / limit);

// Función utilitaria para preservar los filtros en los enlaces de paginación
const getPageUrl = (p: number) => {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", p.toString());
  return `?${params.toString()}`;
};
---

<AdminLayout title="Historial de Citas">
  <div class="max-w-6xl mx-auto space-y-8 text-stone-300 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Encabezado de la página -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-white uppercase tracking-tight">
          Historial de Citas
        </h2>
        <p class="text-stone-500 text-sm mt-1 font-medium italic">
          Busca, filtra y audita el registro de citas de Barber Ray
        </p>
      </div>
    </div>

    <!-- Sección de Filtros -->
    <form method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-4 bg-stone-900 border border-stone-800 p-6 rounded-3xl shadow-xl">
      <!-- Búsqueda -->
      <div class="flex flex-col gap-1.5">
        <label for="search" class="text-2xs font-black text-stone-500 uppercase tracking-ultra">Buscar Cliente</label>
        <input
          type="text"
          id="search"
          name="search"
          value={search}
          placeholder="Nombre o email..."
          class="bg-stone-950 border border-stone-850 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors placeholder:text-stone-600"
        />
      </div>

      <!-- Estado -->
      <div class="flex flex-col gap-1.5">
        <label for="status" class="text-2xs font-black text-stone-500 uppercase tracking-ultra">Estado</label>
        <select
          id="status"
          name="status"
          class="bg-stone-950 border border-stone-850 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
        >
          <option value="all" selected={status === "all"}>Todos los Estados</option>
          <option value="pending" selected={status === "pending"}>Pendiente</option>
          <option value="confirmed" selected={status === "confirmed"}>Confirmada</option>
          <option value="completed" selected={status === "completed"}>Completada</option>
          <option value="cancelled" selected={status === "cancelled"}>Cancelada</option>
        </select>
      </div>

      <!-- Barbero -->
      <div class="flex flex-col gap-1.5">
        <label for="barberId" class="text-2xs font-black text-stone-500 uppercase tracking-ultra">Barbero</label>
        <select
          id="barberId"
          name="barberId"
          class="bg-stone-950 border border-stone-850 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
        >
          <option value="all" selected={barberId === "all"}>Todos los Barberos</option>
          {barbers?.map((barber: any) => (
            <option value={barber.id} selected={barberId === barber.id}>{barber.name}</option>
          ))}
        </select>
      </div>

      <!-- Botones de Acción de Filtros -->
      <div class="flex items-end gap-2">
        <button
          type="submit"
          class="flex-1 bg-amber-500 hover:bg-amber-600 text-stone-950 font-black text-sm py-2.5 rounded-xl transition-all cursor-pointer shadow-lg shadow-amber-500/10 hover:shadow-amber-500/20 text-center uppercase tracking-wider"
        >
          Filtrar
        </button>
        <a
          href="/admin/history"
          class="bg-stone-800 hover:bg-stone-750 text-stone-300 font-bold text-sm px-4 py-2.5 rounded-xl transition-colors text-center border border-stone-700"
        >
          Limpiar
        </a>
      </div>
    </form>

    <!-- Tabla de Historial -->
    <div class="bg-stone-900 border border-stone-800 rounded-3xl overflow-hidden shadow-2xl relative">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-stone-950/50 border-b border-stone-800">
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra whitespace-nowrap">Fecha & Hora</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Cliente</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Servicio</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra">Barbero</th>
              <th class="px-6 py-5 text-2xs font-black text-stone-500 uppercase tracking-ultra whitespace-nowrap">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-800/50">
            {appointments.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-16 text-center text-stone-500">
                  <div class="flex flex-col items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-stone-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    <p class="font-medium">No se encontraron citas con los filtros seleccionados.</p>
                  </div>
                </td>
              </tr>
            ) : (
              appointments.map((app) => {
                const dateObj = new Date(app.appointment_date);
                const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
                const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });
                
                let badgeClass = "bg-stone-800 text-stone-400 border border-stone-700";
                let statusText: string = app.status;
                
                if (app.status === 'pending') {
                  badgeClass = "bg-amber-500/10 text-amber-500 border border-amber-500/20";
                  statusText = "Pendiente";
                } else if (app.status === 'confirmed') {
                  badgeClass = "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20";
                  statusText = "Confirmada";
                } else if (app.status === 'cancelled') {
                  badgeClass = "bg-red-500/10 text-red-500 border border-red-500/20";
                  statusText = "Cancelada";
                } else if (app.status === 'completed') {
                  badgeClass = "bg-blue-500/10 text-blue-500 border border-blue-500/20";
                  statusText = "Completada";
                }

                return (
                  <tr class="hover:bg-stone-800/40 transition-colors group">
                    <td class="px-6 py-5 whitespace-nowrap">
                      <div class="flex flex-col">
                        <span class="font-bold text-white capitalize text-sm">{dateStr}</span>
                        <span class="text-xs text-amber-500 font-bold mt-0.5">{timeStr}</span>
                      </div>
                    </td>
                    <td class="px-6 py-5">
                      <div class="flex flex-col">
                        <span class="font-bold text-white text-sm">{app.client_name}</span>
                        <span class="text-xs text-stone-500 mt-0.5">
                          {app.client_email || "Sin email registrado"}
                          {app.client_phone && <span class="text-stone-600 ml-1.5">• {app.client_phone}</span>}
                        </span>
                      </div>
                    </td>
                    <td class="px-6 py-5">
                      <div class="flex flex-col">
                        <span class="font-medium text-stone-300 text-sm">{app.service?.name || "N/A"}</span>
                        <span class="text-xs text-stone-500 mt-0.5">
                          {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "-"} • 
                          <span class="font-bold">
                            {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                          </span>
                        </span>
                      </div>
                    </td>
                    <td class="px-6 py-5 whitespace-nowrap">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-stone-950 border border-stone-800 flex items-center justify-center text-xs font-black text-amber-500 shadow-inner">
                          {app.barber?.name?.charAt(0) || "?"}
                        </div>
                        <span class="text-sm font-medium text-stone-300">{app.barber?.name || "Sin Asignar"}</span>
                      </div>
                    </td>
                    <td class="px-6 py-5 whitespace-nowrap">
                      <span class={`px-3 py-1.5 text-2xs font-black uppercase tracking-ultra rounded-lg inline-flex items-center gap-2 ${badgeClass}`}>
                        <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                        {statusText}
                      </span>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      <!-- Paginación -->
      {totalPages > 1 && (
        <div class="px-6 py-5 bg-stone-950/30 border-t border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-stone-500 font-medium">
            Página <span class="text-stone-300 font-bold">{page}</span> de <span class="text-stone-300 font-bold">{totalPages}</span> 
            <span class="mx-1.5">•</span> 
            <span class="text-stone-400 font-semibold">{totalCount}</span> citas encontradas
          </p>

          <div class="flex items-center gap-2">
            <a
              href={page > 1 ? getPageUrl(page - 1) : "#"}
              class={`px-4 py-2 rounded-xl text-xs font-bold border border-stone-800 transition-colors select-none ${page > 1 ? "bg-stone-900 hover:bg-stone-850 text-white cursor-pointer" : "text-stone-650 border-stone-900 pointer-events-none"}`}
            >
              Anterior
            </a>
            
            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }).map((_, idx) => {
                const targetPage = idx + 1;
                // Mostrar un rango limitado si hay muchas páginas
                if (totalPages > 5 && Math.abs(page - targetPage) > 1 && targetPage !== 1 && targetPage !== totalPages) {
                  if (targetPage === 2 || targetPage === totalPages - 1) {
                    return <span class="px-1 text-stone-650 font-bold text-xs select-none">...</span>;
                  }
                  return null;
                }
                const isCurrent = page === targetPage;
                return (
                  <a
                    href={getPageUrl(targetPage)}
                    class={`w-8 h-8 rounded-lg text-xs font-black flex items-center justify-center transition-all ${isCurrent ? "bg-amber-500 text-stone-950" : "bg-stone-900 hover:bg-stone-800 text-stone-400 hover:text-white border border-stone-800"}`}
                  >
                    {targetPage}
                  </a>
                );
              })}
            </div>

            <a
              href={page < totalPages ? getPageUrl(page + 1) : "#"}
              class={`px-4 py-2 rounded-xl text-xs font-bold border border-stone-800 transition-colors select-none ${page < totalPages ? "bg-stone-900 hover:bg-stone-850 text-white cursor-pointer" : "text-stone-650 border-stone-900 pointer-events-none"}`}
            >
              Siguiente
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
