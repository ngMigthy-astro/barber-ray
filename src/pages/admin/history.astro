---
// src/pages/admin/history.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import type { AgendaAppointment, AppointmentStatus } from "../../interfaces/admin/agenda.interface";

// 1. Validaciones de sesión de Administrador
const { user } = Astro.locals;
if (!user) return Astro.redirect("/admin");

const supabase = createSupabaseClient(Astro.request, Astro.cookies);

// 2. Parámetros de filtros y paginación desde la URL
const url = Astro.url;
const search = url.searchParams.get("search") || "";
const status = url.searchParams.get("status") || "all";
const barberId = url.searchParams.get("barberId") || "all";
const page = parseInt(url.searchParams.get("page") || "1", 10);
const limit = 10;
const offset = (page - 1) * limit;

// 3. Traer Barberos para el filtro dropdown
const { data: barbers } = await supabase
  .from("team_members")
  .select("id, name")
  .order("name", { ascending: true });

// 4. Búsqueda de clientes por nombre o email si se provee
let userIds: string[] = [];
let hasSearch = false;
if (search.trim()) {
  hasSearch = true;
  const { data: matchedProfiles } = await supabase
    .from("profiles")
    .select("id")
    .or(`full_name.ilike.%${search}%,email.ilike.%${search}%`);
  userIds = (matchedProfiles || []).map((p: any) => p.id);
}

// 5. Construcción de Query de Citas con PostgREST
let query = supabase
  .from("appointments")
  .select(`
    id,
    user_id,
    appointment_date,
    status,
    client_name,
    client_phone,
    profiles:user_id(full_name, email),
    service:service_id(name, duration, price),
    barber:barber_id(name)
  `, { count: "exact" });

// Filtro de búsqueda por cliente (soporta cuentas de usuario y nombres manuales)
if (hasSearch) {
  if (userIds.length > 0) {
    query = query.or(`user_id.in.(${userIds.join(",")}),client_name.ilike.%${search}%`);
  } else {
    query = query.ilike("client_name", `%${search}%`);
  }
}

// Filtro de estado
if (status !== "all") {
  query = query.eq("status", status);
}

// Filtro de barbero
if (barberId !== "all") {
  query = query.eq("barber_id", barberId);
}

// Paginación y orden (mostrando las más recientes primero para ver el historial activo)
query = query
  .order("appointment_date", { ascending: false })
  .range(offset, offset + limit - 1);

const { data: rawAppointments, error, count } = await query;

const appointments: AgendaAppointment[] = (rawAppointments || []).map((app: any) => ({
  id: app.id,
  user_id: app.user_id,
  client_name: app.client_name || app.profiles?.full_name || "Cliente Desconocido",
  client_email: app.profiles?.email,
  client_phone: app.client_phone,
  service: app.service,
  barber: app.barber,
  appointment_date: app.appointment_date,
  status: app.status
}));

const totalCount = count || 0;
const totalPages = Math.ceil(totalCount / limit);

// Función utilitaria para preservar los filtros en los enlaces de paginación
const getPageUrl = (p: number) => {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", p.toString());
  return `?${params.toString()}`;
};
---

<AdminLayout title="Historial de Citas">
  <div class="w-full space-y-8 text-zinc-700 dark:text-zinc-300 animate-in fade-in slide-in-from-bottom-4 duration-700">

    <!-- ══════════════ HEADER ══════════════ -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="space-y-1.5">
        <!-- Línea decorativa indigo -->
        <div class="flex items-center gap-3">
          <div class="w-1 h-7 rounded-full bg-indigo-600 dark:bg-indigo-400 shadow-md shadow-indigo-500/20"></div>
          <h2 class="text-2xl font-black text-zinc-950 dark:text-white uppercase tracking-tight font-display">
            Historial de Citas
          </h2>
        </div>
        <p class="text-zinc-500 dark:text-zinc-400 text-sm font-medium pl-4">
          Busca, filtra y audita el registro completo de Barber Ray
        </p>
      </div>
      <!-- Contador total -->
      <div class="flex items-center gap-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl px-4 py-2.5 self-start sm:self-auto shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
          <line x1="16" x2="16" y1="2" y2="6"/>
          <line x1="8" x2="8" y1="2" y2="6"/>
          <line x1="3" x2="21" y1="10" y2="10"/>
        </svg>
        <span class="text-sm font-black text-zinc-950 dark:text-white">{totalCount}</span>
        <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">citas en total</span>
      </div>
    </div>

    <!-- ══════════════ PANEL DE FILTROS ══════════════ -->
    <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-6 shadow-xs">

      <!-- Búsqueda -->
      <div class="flex flex-col gap-1.5">
        <label for="search" class="text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1.5 block">
          Buscar Cliente
        </label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input
            type="text"
            id="search"
            name="search"
            value={search}
            placeholder="Nombre o email..."
            class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/80 rounded-xl pl-9 pr-4 py-2.5 text-sm text-zinc-950 dark:text-white focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/60 transition-all w-full placeholder:text-zinc-400"
          />
        </div>
      </div>

      <!-- Estado -->
      <div class="flex flex-col gap-1.5">
        <label for="status" class="text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1.5 block">
          Estado
        </label>
        <select
          id="status"
          name="status"
          class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/80 rounded-xl px-4 py-2.5 text-sm text-zinc-950 dark:text-white focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/60 transition-all w-full appearance-none cursor-pointer"
        >
          <option value="all" selected={status === "all"}>Todos los Estados</option>
          <option value="pending" selected={status === "pending"}>Pendiente</option>
          <option value="confirmed" selected={status === "confirmed"}>Confirmada</option>
          <option value="completed" selected={status === "completed"}>Completada</option>
          <option value="cancelled" selected={status === "cancelled"}>Cancelada</option>
        </select>
      </div>

      <!-- Barbero -->
      <div class="flex flex-col gap-1.5">
        <label for="barberId" class="text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1.5 block">
          Barbero
        </label>
        <select
          id="barberId"
          name="barberId"
          class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/80 rounded-xl px-4 py-2.5 text-sm text-zinc-950 dark:text-white focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/60 transition-all w-full appearance-none cursor-pointer"
        >
          <option value="all" selected={barberId === "all"}>Todos los Barberos</option>
          {barbers?.map((barber: any) => (
            <option value={barber.id} selected={barberId === barber.id}>{barber.name}</option>
          ))}
        </select>
      </div>

      <!-- Botones de Acción -->
      <div class="flex items-end gap-2">
        <button
          type="submit"
          class="flex-1 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold text-xs py-3 rounded-xl transition-all cursor-pointer shadow-xs text-center uppercase tracking-wider"
        >
          Filtrar
        </button>
        <a
          href="/admin/history"
          class="bg-transparent hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 dark:text-zinc-400 font-bold text-xs px-4 py-3 rounded-xl transition-all text-center border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 whitespace-nowrap"
        >
          Limpiar
        </a>
      </div>
    </form>

    <!-- ══════════════ TABLA + CARDS ══════════════ -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl overflow-hidden shadow-xs relative">

      <!-- Vista Escritorio (Tabla) -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-zinc-50 dark:bg-zinc-950/40 border-b border-zinc-200 dark:border-zinc-800/80">
              <th class="px-6 py-5 text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider whitespace-nowrap">Fecha & Hora</th>
              <th class="px-6 py-5 text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Cliente</th>
              <th class="px-6 py-5 text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Servicio</th>
              <th class="px-6 py-5 text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Barbero</th>
              <th class="px-6 py-5 text-2xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider whitespace-nowrap">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/60 dark:divide-zinc-800/40">
            {appointments.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-20 text-center">
                  <div class="flex flex-col items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-750 flex items-center justify-center text-zinc-400">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                        <line x1="16" x2="16" y1="2" y2="6"/>
                        <line x1="8" x2="8" y1="2" y2="6"/>
                        <line x1="3" x2="21" y1="10" y2="10"/>
                        <path d="m9 16 2 2 4-4"/>
                      </svg>
                    </div>
                    <div class="space-y-1">
                      <p class="font-bold text-zinc-800 dark:text-zinc-200 text-sm uppercase tracking-wider">Sin resultados</p>
                      <p class="text-zinc-500 dark:text-zinc-500 text-xs">No hay citas que coincidan con los filtros aplicados.</p>
                    </div>
                  </div>
                </td>
              </tr>
            ) : (
              appointments.map((app) => {
                const dateObj = new Date(app.appointment_date);
                const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
                const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });

                let badgeClass = "bg-zinc-100 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60";
                let statusText: string = app.status;

                if (app.status === 'pending') {
                  badgeClass = "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-500/20";
                  statusText = "Pendiente";
                } else if (app.status === 'confirmed') {
                  badgeClass = "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-500/20";
                  statusText = "Confirmada";
                } else if (app.status === 'cancelled') {
                  badgeClass = "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-500/20";
                  statusText = "Cancelada";
                } else if (app.status === 'completed') {
                  badgeClass = "bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-500/20";
                  statusText = "Completada";
                }

                return (
                  <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/20 transition-colors duration-150 group">
                    <!-- Fecha -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="inline-flex flex-col bg-indigo-50 dark:bg-indigo-500/10 rounded-lg px-2.5 py-1.5">
                        <span class="font-bold text-zinc-900 dark:text-white capitalize text-xs leading-tight">{dateStr}</span>
                        <span class="text-2xs text-indigo-600 dark:text-indigo-400 font-extrabold mt-0.5">{timeStr}</span>
                      </div>
                    </td>
                    <!-- Cliente -->
                    <td class="px-6 py-4">
                      <div class="flex flex-col">
                        <span class="font-bold text-zinc-900 dark:text-white text-sm leading-tight">{app.client_name}</span>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 truncate max-w-[200px]">
                          {app.client_email || "Sin email registrado"}
                        </span>
                        {app.client_phone && (
                          <span class="text-2xs text-zinc-400 dark:text-zinc-500 mt-0.5">• {app.client_phone}</span>
                        )}
                      </div>
                    </td>
                    <!-- Servicio -->
                    <td class="px-6 py-4">
                      <div class="flex flex-col">
                        <span class="font-semibold text-zinc-850 dark:text-zinc-200 text-sm">{app.service?.name || "N/A"}</span>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                          {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "—"}
                          {" · "}
                          <span class="font-bold text-zinc-900 dark:text-indigo-450">
                            {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                          </span>
                        </span>
                      </div>
                    </td>
                    <!-- Barbero -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-zinc-150 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-bold text-zinc-700 dark:text-zinc-300 shrink-0">
                          {app.barber?.name?.charAt(0).toUpperCase() || "?"}
                        </div>
                        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-350">{app.barber?.name || "Sin Asignar"}</span>
                      </div>
                    </td>
                    <!-- Estado -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class={`px-3 py-1.5 text-2xs font-bold uppercase tracking-wider rounded-lg inline-flex items-center gap-1.5 ${badgeClass}`}>
                        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                        {statusText}
                      </span>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      <!-- Vista Móvil (Cards) -->
      <div class="block md:hidden divide-y divide-zinc-200/60 dark:divide-zinc-800/40">
        {appointments.length === 0 ? (
          <div class="px-6 py-20 text-center">
            <div class="flex flex-col items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-750 flex items-center justify-center text-zinc-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                  <line x1="16" x2="16" y1="2" y2="6"/>
                  <line x1="8" x2="8" y1="2" y2="6"/>
                  <line x1="3" x2="21" y1="10" y2="10"/>
                  <path d="m9 16 2 2 4-4"/>
                </svg>
              </div>
              <div class="space-y-1">
                <p class="font-bold text-zinc-850 dark:text-zinc-200 text-sm uppercase tracking-wider">Sin resultados</p>
                <p class="text-zinc-500 dark:text-zinc-500 text-xs">No hay citas que coincidan con los filtros aplicados.</p>
              </div>
            </div>
          </div>
        ) : (
          appointments.map((app) => {
            const dateObj = new Date(app.appointment_date);
            const dateStr = dateObj.toLocaleDateString("es-MX", { weekday: 'short', day: '2-digit', month: 'short' });
            const timeStr = dateObj.toLocaleTimeString("es-MX", { hour: '2-digit', minute: '2-digit' });

            let badgeClass = "bg-zinc-100 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60";
            let statusText: string = app.status;

            if (app.status === 'pending') {
              badgeClass = "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-500/20";
              statusText = "Pendiente";
            } else if (app.status === 'confirmed') {
              badgeClass = "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-500/20";
              statusText = "Confirmada";
            } else if (app.status === 'cancelled') {
              badgeClass = "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-500/20";
              statusText = "Cancelada";
            } else if (app.status === 'completed') {
              badgeClass = "bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-500/20";
              statusText = "Completada";
            }

            return (
              <div class="border-b border-zinc-200 dark:border-zinc-800/40 p-5 space-y-3.5">
                {/* Header: Fecha chip + Badge status */}
                <div class="flex items-start justify-between gap-3">
                  <div class="inline-flex flex-col bg-indigo-50 dark:bg-indigo-500/10 rounded-lg px-2.5 py-1.5">
                    <span class="font-bold text-zinc-900 dark:text-white capitalize text-xs leading-tight">{dateStr}</span>
                    <span class="text-2xs text-indigo-600 dark:text-indigo-400 font-extrabold mt-0.5">{timeStr}</span>
                  </div>
                  <span class={`px-2.5 py-1 text-2xs font-bold uppercase tracking-wider rounded-lg inline-flex items-center gap-1.5 shrink-0 ${badgeClass}`}>
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    {statusText}
                  </span>
                </div>

                {/* Cliente */}
                <div>
                  <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block mb-0.5">Cliente</span>
                  <span class="font-bold text-zinc-900 dark:text-zinc-150 text-sm block">{app.client_name}</span>
                  <span class="text-zinc-550 dark:text-zinc-400 text-xs block mt-0.5 truncate">
                    {app.client_email || "Sin email registrado"}
                    {app.client_phone && <span class="text-zinc-400 dark:text-zinc-650 ml-1.5">• {app.client_phone}</span>}
                  </span>
                </div>

                {/* Servicio + Barbero */}
                <div class="grid grid-cols-2 gap-4 pt-3.5 border-t border-zinc-200 dark:border-zinc-800/40">
                  <div>
                    <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block mb-0.5">Servicio</span>
                    <span class="font-bold text-zinc-800 dark:text-zinc-250 text-xs block">{app.service?.name || "N/A"}</span>
                    <span class="text-zinc-500 dark:text-zinc-400 text-2xs block mt-0.5">
                      {app.service?.duration ? (String(app.service.duration).toLowerCase().includes("min") ? app.service.duration : `${app.service.duration} min`) : "—"}
                      {" · "}
                      <span class="font-bold text-indigo-600 dark:text-indigo-400">
                        {app.service?.price ? (String(app.service.price).startsWith("$") ? app.service.price : `$${app.service.price}`) : "$0"}
                      </span>
                    </span>
                  </div>
                  <div>
                    <span class="text-3xs font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block mb-0.5">Barbero</span>
                    <div class="flex items-center gap-2 mt-0.5">
                      <div class="w-6 h-6 rounded-lg bg-zinc-150 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/60 flex items-center justify-center text-2xs font-bold text-indigo-600 dark:text-indigo-400 shrink-0">
                        {app.barber?.name?.charAt(0).toUpperCase() || "?"}
                      </div>
                      <span class="font-bold text-zinc-800 dark:text-zinc-250 text-xs">{app.barber?.name || "Sin Asignar"}</span>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>

      <!-- ══════════════ PAGINACIÓN ══════════════ -->
      {totalPages > 1 && (
        <div class="px-6 py-5 bg-zinc-50/50 dark:bg-zinc-950/40 border-t border-zinc-200 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-zinc-550 dark:text-zinc-400 font-medium">
            Página <span class="text-zinc-900 dark:text-zinc-300 font-extrabold">{page}</span> de <span class="text-zinc-900 dark:text-zinc-300 font-extrabold">{totalPages}</span>
            <span class="mx-2 text-zinc-200 dark:text-zinc-800">•</span>
            <span class="text-indigo-600 dark:text-indigo-400 font-extrabold">{totalCount}</span> citas encontradas
          </p>

          <div class="flex items-center gap-1.5">
            <!-- Anterior -->
            <a
              href={page > 1 ? getPageUrl(page - 1) : "#"}
              class={`px-3.5 py-2 rounded-xl text-xs font-bold border transition-all select-none ${page > 1 ? "bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-350 hover:text-zinc-950 dark:hover:text-white border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 cursor-pointer" : "text-zinc-300 dark:text-zinc-800/40 border-zinc-200 dark:border-zinc-800/40 pointer-events-none"}`}
            >
              ← Anterior
            </a>

            <!-- Páginas -->
            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }).map((_, idx) => {
                const targetPage = idx + 1;
                if (totalPages > 5 && Math.abs(page - targetPage) > 1 && targetPage !== 1 && targetPage !== totalPages) {
                  if (targetPage === 2 || targetPage === totalPages - 1) {
                    return <span class="px-1.5 text-zinc-400 dark:text-zinc-600 font-bold text-xs select-none">…</span>;
                  }
                  return null;
                }
                const isCurrent = page === targetPage;
                return (
                  <a
                    href={getPageUrl(targetPage)}
                    class={`w-8 h-8 rounded-xl text-xs font-bold flex items-center justify-center transition-all ${isCurrent ? "bg-indigo-650 text-white shadow-xs shadow-indigo-500/20" : "bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white border border-zinc-200 dark:border-zinc-800/80"}`}
                  >
                    {targetPage}
                  </a>
                );
              })}
            </div>

            <!-- Siguiente -->
            <a
              href={page < totalPages ? getPageUrl(page + 1) : "#"}
              class={`px-3.5 py-2 rounded-xl text-xs font-bold border transition-all select-none ${page < totalPages ? "bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-350 hover:text-zinc-950 dark:hover:text-white border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 cursor-pointer" : "text-zinc-300 dark:text-zinc-800/40 border-zinc-200 dark:border-zinc-800/40 pointer-events-none"}`}
            >
              Siguiente →
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
