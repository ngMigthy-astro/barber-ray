---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../lib/supabase";
import {
  Scissors,
  Brush,
  Sparkles,
  Wind,
  Trash2,
  Plus,
  Save,
  X,
} from "lucide-react";

const { cookies, request } = Astro;
const supabase = createSupabaseClient(request, cookies);

const { data: sectionConfig } = await supabase
  .from("section_configs")
  .select("*")
  .eq("id", "services")
  .single();

const config = sectionConfig || {
  title: "Nuestros Servicios",
  subtitle: "Experiencia Premium",
};

const { data: dbServices } = await supabase
  .from("services")
  .select("*")
  .order("sort_order", { ascending: true });

const services = dbServices || [];

let successMessage = "";
let errorMessage = "";

if (request.method === "POST") {
  try {
    const formData = await request.formData();
    const action = formData.get("action");

    if (action === "update_config") {
      const { error } = await supabase.from("section_configs").upsert({
        id: "services",
        title: formData.get("title")?.toString() || "",
        subtitle: formData.get("subtitle")?.toString() || "",
        updated_at: new Date().toISOString(),
      });
      if (error) throw error;
      successMessage = "¡Configuración de la sección actualizada!";
    } else if (action === "upsert_service") {
      const id = formData.get("id")?.toString();
      const rawPrice = formData.get("price")?.toString() || "";
      const price = rawPrice.replace(/[^0-9]/g, "");
      const rawDuration = formData.get("duration")?.toString() || "";
      const duration = rawDuration.replace(/[^0-9]/g, "");

      const serviceData = {
        name: formData.get("name")?.toString() || "",
        description: formData.get("description")?.toString() || "",
        price,
        duration,
        icon_name: formData.get("icon_name")?.toString() || "Scissors",
        sort_order: parseInt(formData.get("sort_order")?.toString() || "0"),
      };

      const { error } = id
        ? await supabase.from("services").update(serviceData).eq("id", id)
        : await supabase.from("services").insert([serviceData]);

      if (error) throw error;
      successMessage = id
        ? "¡Servicio actualizado!"
        : "¡Nuevo servicio creado!";
    } else if (action === "delete_service") {
      const id = formData.get("id")?.toString();
      const { error } = await supabase.from("services").delete().eq("id", id);
      if (error) throw error;
      successMessage = "Servicio eliminado correctamente.";
    }

    return Astro.redirect("/admin/services?success=true");
  } catch (e) {
    errorMessage = (e as Error).message;
  }
}

const isSuccess = Astro.url.searchParams.get("success") === "true";

const availableIcons = [
  { name: "Scissors", icon: Scissors },
  { name: "Brush", icon: Brush },
  { name: "Sparkles", icon: Sparkles },
  { name: "Wind", icon: Wind },
];
---

<AdminLayout title="Gestión de Servicios">
  <div class="max-w-5xl">
    {
      isSuccess && (
        <div
          id="success-notification"
          class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <Save className="w-5 h-5" />
            <span class="font-medium">
              Los cambios se han guardado y publicado correctamente.
            </span>
          </div>
          <button
            onclick="document.getElementById('success-notification').style.display='none'"
            class="text-emerald-500/70 hover:text-emerald-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          id="error-notification"
          class="mb-6 p-4 bg-red-500/10 border border-red-500/20 text-red-500 rounded-2xl flex items-center justify-between gap-3 animate-in fade-in slide-in-from-top-4"
        >
          <div class="flex items-center gap-3">
            <span class="font-medium">Error: {errorMessage}</span>
          </div>
          <button
            onclick="document.getElementById('error-notification').style.display='none'"
            class="text-red-500/70 hover:text-red-500 transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Configuración de la Sección -->
      <div class="lg:col-span-1 space-y-6">
        <div
          class="bg-stone-900 border border-stone-800 rounded-3xl p-6 shadow-xl"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-6 bg-primary rounded-full"></div>
            <h3 class="text-sm font-black text-white uppercase tracking-widest">
              Textos de Sección
            </h3>
          </div>

          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value="update_config" />
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Título Principal</label
              >
              <input
                type="text"
                name="title"
                value={config.title}
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all text-sm"
              />
            </div>
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Subtítulo</label
              >
              <input
                type="text"
                name="subtitle"
                value={config.subtitle}
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all text-sm"
              />
            </div>
            <button
              type="submit"
              class="w-full btn-premium py-3 flex items-center justify-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              Guardar Sección
            </button>
          </form>
        </div>

        <!-- Agregar Nuevo Servicio -->
        <div
          class="bg-stone-900 border border-stone-800 rounded-3xl p-6 shadow-xl"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-6 bg-emerald-500 rounded-full"></div>
            <h3 class="text-sm font-black text-white uppercase tracking-widest">
              Nuevo Servicio
            </h3>
          </div>

          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value="upsert_service" />
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Nombre</label
                >
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                />
              </div>
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Icono</label
                >
                <input type="hidden" name="icon_name" id="new-service-icon" value="Scissors" />
                <div class="flex gap-2" id="new-service-icon-selector">
                  {
                    availableIcons.map((icon) => {
                      const IconComponent = icon.icon;
                      return (
                        <button
                          type="button"
                          data-icon={icon.name}
                          title={icon.name}
                          class="w-10 h-10 rounded-xl bg-stone-950 border border-stone-800 flex items-center justify-center text-stone-500 hover:text-white hover:border-stone-600 transition-colors focus:outline-none cursor-pointer"
                        >
                          <IconComponent className="w-5 h-5" />
                        </button>
                      );
                    })
                  }
                </div>
              </div>
            </div>
            <div class="space-y-2">
              <label
                class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                >Descripción Corta</label
              >
              <textarea
                name="description"
                rows="2"
                required
                class="w-full bg-stone-950 border border-stone-800 rounded-xl px-3 py-2 text-white text-sm outline-none focus:border-emerald-500 resize-none"
              ></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Precio</label
                >
                <div class="relative">
                  <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-500 text-sm font-bold">$</span>
                  <input
                    type="number"
                    name="price"
                    placeholder="00"
                    min="0"
                    required
                    class="w-full bg-stone-950 border border-stone-800 rounded-xl pl-8 pr-3 py-2 text-white text-sm outline-none focus:border-emerald-500"
                  />
                </div>
              </div>
              <div class="space-y-2">
                <label
                  class="text-2xs font-black text-stone-500 uppercase tracking-ultra px-1"
                  >Duración</label
                >
                <div class="relative">
                  <input
                    type="number"
                    name="duration"
                    placeholder="30"
                    min="1"
                    required
                    class="w-full bg-stone-950 border border-stone-800 rounded-xl pl-3 pr-12 py-2 text-white text-sm outline-none focus:border-emerald-500"
                  />
                  <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-stone-500 text-xs font-bold uppercase tracking-widest pointer-events-none">MIN</span>
                </div>
              </div>
            </div>
            <button
              type="submit"
              class="w-full bg-emerald-500 hover:bg-emerald-600 text-stone-950 font-black py-3 rounded-xl flex items-center justify-center gap-2 text-xs uppercase tracking-widest transition-all cursor-pointer"
            >
              <Plus className="w-4 h-4" />
              Crear Servicio
            </button>
          </form>
        </div>
      </div>

      <!-- Lista de Servicios Actuales -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xl font-bold text-white">Servicios Activos</h3>
          <span
            class="px-3 py-1 bg-stone-900 border border-stone-800 rounded-full text-2xs font-black text-stone-500 uppercase"
            >{services.length} servicios</span
          >
        </div>

        <div class="grid grid-cols-1 gap-4">
          {
            services.map((service, index) => (
              <div class="bg-stone-900 border border-stone-800 rounded-4xl p-6 hover:border-primary/50 transition-all group">
                <form method="POST" class="flex flex-col md:flex-row gap-6">
                  <input type="hidden" name="action" value="upsert_service" />
                  <input type="hidden" name="id" value={service.id} />
                  <input type="hidden" name="sort_order" value={index} />

                  <div class="flex flex-col items-center gap-3">
                    <div 
                      id={`icon-preview-${service.id}`}
                      class="w-16 h-16 rounded-2xl bg-stone-950 flex items-center justify-center text-primary border border-stone-800"
                    >
                      {(() => {
                        const iconEntry = availableIcons.find(
                          (i) => i.name === service.icon_name,
                        );
                        const IconComponent = iconEntry?.icon || Scissors;
                        return <IconComponent className="w-8 h-8" />;
                      })()}
                    </div>
                    <input type="hidden" name="icon_name" id={`icon-input-${service.id}`} value={service.icon_name} />
                    <div class="flex gap-1" data-service-id={service.id} data-icon-selector="true">
                      {availableIcons.map((icon) => {
                        const IconComponent = icon.icon;
                        const isSelected = service.icon_name === icon.name;
                        return (
                          <button
                            type="button"
                            data-icon={icon.name}
                            title={icon.name}
                            class={`w-7 h-7 rounded-lg border flex items-center justify-center transition-all cursor-pointer ${
                              isSelected
                                ? "bg-primary/20 border-primary text-primary"
                                : "bg-stone-950 border-stone-800 text-stone-500 hover:text-stone-300 hover:border-stone-700"
                            }`}
                          >
                            <IconComponent className="w-3.5 h-3.5" />
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  <div class="flex-1 min-w-0 space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <input
                        type="text"
                        name="name"
                        value={service.name}
                        class="w-full bg-transparent text-xl font-bold text-white outline-none focus:text-primary transition-colors"
                      />
                      <div class="flex gap-2">
                        <div class="relative w-24 shrink-0">
                          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-primary font-black text-xs">$</span>
                          <input
                            type="number"
                            name="price"
                            min="0"
                            value={String(service.price).replace(/[^0-9]/g, "")}
                            class="w-full bg-stone-950 border border-stone-800 rounded-lg pl-7 pr-2 py-1 text-primary font-black text-center text-sm outline-none focus:border-emerald-500"
                          />
                        </div>
                        <div class="relative flex-1 w-full min-w-0">
                          <input
                            type="number"
                            name="duration"
                            min="1"
                            value={String(service.duration).replace(/[^0-9]/g, "")}
                            class="w-full bg-stone-950 border border-stone-800 rounded-lg pl-3 pr-10 py-1 text-2xs text-stone-300 font-bold text-center outline-none focus:border-emerald-500"
                          />
                          <span class="absolute right-2 top-1/2 -translate-y-1/2 text-stone-500 text-3xs font-bold uppercase pointer-events-none">MIN</span>
                        </div>
                      </div>
                    </div>
                    <textarea
                      name="description"
                      rows="2"
                      class="w-full bg-transparent text-stone-400 text-sm outline-none focus:text-stone-200 transition-colors resize-none"
                    >{service.description.trim()}</textarea>

                    <div class="flex items-center justify-end gap-3 pt-2 border-t border-stone-800/50">
                      <button
                        type="submit"
                        class="flex items-center gap-2 text-xs font-black text-stone-500 hover:text-emerald-500 transition-colors uppercase tracking-widest cursor-pointer"
                      >
                        <Save className="w-3 h-3" />
                        Guardar
                      </button>
                      <button
                        form={`delete-${service.id}`}
                        type="submit"
                        class="flex items-center gap-2 text-xs font-black text-stone-500 hover:text-red-500 transition-colors uppercase tracking-widest cursor-pointer"
                      >
                        <Trash2 className="w-3 h-3" />
                        Eliminar
                      </button>
                    </div>
                  </div>
                </form>

                <form id={`delete-${service.id}`} method="POST" class="hidden">
                  <input type="hidden" name="action" value="delete_service" />
                  <input type="hidden" name="id" value={service.id} />
                </form>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // 1. Manejo del selector de iconos para "Nuevo Servicio"
  const newServiceSelector = document.getElementById("new-service-icon-selector");
  const newServiceInput = document.getElementById("new-service-icon") as HTMLInputElement;
  if (newServiceSelector && newServiceInput) {
    const buttons = newServiceSelector.querySelectorAll("button");
    
    // Activar visualmente el icono por defecto
    buttons.forEach((btn) => {
      if (btn.getAttribute("data-icon") === newServiceInput.value) {
        btn.classList.add("border-emerald-500", "text-emerald-500", "bg-emerald-500/10");
        btn.classList.remove("border-stone-800", "text-stone-500");
      }
      
      btn.addEventListener("click", () => {
        const selectedIcon = btn.getAttribute("data-icon") || "Scissors";
        newServiceInput.value = selectedIcon;
        
        buttons.forEach((b) => {
          b.classList.remove("border-emerald-500", "text-emerald-500", "bg-emerald-500/10");
          b.classList.add("border-stone-800", "text-stone-500");
        });
        
        btn.classList.add("border-emerald-500", "text-emerald-500", "bg-emerald-500/10");
        btn.classList.remove("border-stone-800", "text-stone-500");
      });
    });
  }

  // 2. Manejo del selector de iconos para "Servicios Activos"
  const activeSelectors = document.querySelectorAll('[data-icon-selector="true"]');
  activeSelectors.forEach((selector) => {
    const serviceId = selector.getAttribute("data-service-id");
    const hiddenInput = document.getElementById(`icon-input-${serviceId}`) as HTMLInputElement;
    const previewContainer = document.getElementById(`icon-preview-${serviceId}`);
    const buttons = selector.querySelectorAll("button");
    
    if (hiddenInput && previewContainer) {
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const selectedIcon = btn.getAttribute("data-icon") || "Scissors";
          hiddenInput.value = selectedIcon;
          
          // Actualizar clases de los botones del selector
          buttons.forEach((b) => {
            b.classList.remove("bg-primary/20", "border-primary", "text-primary");
            b.classList.add("bg-stone-950", "border-stone-800", "text-stone-500");
          });
          
          btn.classList.add("bg-primary/20", "border-primary", "text-primary");
          btn.classList.remove("bg-stone-950", "border-stone-800", "text-stone-500");
          
          // Copiar el SVG al contenedor de preview grande
          previewContainer.innerHTML = btn.innerHTML;
          
          // Ajustar el tamaño del SVG en el preview
          const svg = previewContainer.querySelector("svg");
          if (svg) {
            svg.classList.remove("w-3.5", "h-3.5");
            svg.classList.add("w-8", "h-8");
          }
        });
      });
    }
  });
</script>
